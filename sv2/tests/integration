#!/bin/bash
# Privileged integration tests for sv2: real accounts, real sessions.
#
# Usage: integration DIR     (DIR holds the sv2 and sv2-helper to test)
#
# Runs only against an installed helper that is byte-identical to DIR's.
# Everything is done in a throwaway profile with a random name; the caller's
# other profiles, and this checkout, are never touched (review-guidelines §8).
# Escapes are judged from the host side, not from what the sandbox reports.
#
# No -E and no ERR trap: most commands here are expected to fail inside $(...)
# and are judged by check/refused, so a trap would only add noise.
# shellcheck disable=SC2016 # literal $ and backticks are test data
# shellcheck disable=SC2310,SC2312 # failures are handled by the checks
set -euo pipefail

BIN_DIR="${1:?usage: integration DIR}"
# Absolute: some checks run sv2 from another directory.
BIN_DIR="$(cd "$BIN_DIR" && pwd)"
SV2="$BIN_DIR/sv2"
BUILT_HELPER="$BIN_DIR/sv2-helper"
HELPER="/Library/PrivilegedHelperTools/sv2-helper"
STAT=/usr/bin/stat

RED='\033[0;31m'; GREEN='\033[0;32m'; ORANGE='\033[38;5;208m'; NC='\033[0m'

skip() {
    echo -e "${ORANGE}sv2 integration tests SKIPPED: $1${NC}"
    echo "    to run them: $SV2 install   (needs sudo)"
    if [[ "${SV_TESTS_FAIL_ON_SKIP:-0}" == "1" ]]; then
        echo >&2 "SV_TESTS_FAIL_ON_SKIP=1: a skipped suite is a failure"
        exit 1
    fi
    exit 0
}

[[ -x "$SV2" && -x "$BUILT_HELPER" ]] || { echo >&2 "no sv2 build in $BIN_DIR"; exit 1; }
[[ -f "$HELPER" ]] || skip "sv2 is not installed"
/usr/bin/cmp -s "$BUILT_HELPER" "$HELPER" || skip "the installed helper is not this build"
# What the helper compares: the artifact versions, not the application's.
VERSION="$("$SV2" --version | /usr/bin/awk '$1 == "install-version" {print $2}')"
APP_VERSION="$("$SV2" --version | /usr/bin/awk 'NR == 1 {print $2}')"
[[ -n "$VERSION" && -n "$APP_VERSION" ]] || { echo >&2 "cannot read versions from $SV2 --version"; exit 1; }
/usr/bin/sudo -n -- "$HELPER" call "$VERSION" profile-list >/dev/null 2>&1 \
    || skip "$(id -un) is not in the sv2-users group"

HOST_USER="$(id -un)"
HOST_UID="$(id -u)"
P="svt$((RANDOM % 90000 + 10000))"
ACCOUNT="sv2-$HOST_USER-$P"
WS="/Users/Shared/sv2/$HOST_USER/$P"
SB="/Library/Application Support/sandvault2/profiles/$HOST_USER/$P.sb"
SSHD_DROPIN="/etc/ssh/sshd_config.d/000-sandvault2.conf"

PASSED=0
FAILED=0
pass() { PASSED=$((PASSED + 1)); [[ "${VERBOSE:-0}" == "0" ]] || echo -e "${GREEN}ok${NC}   $1"; }
fail() { FAILED=$((FAILED + 1)); echo -e "${RED}FAIL${NC} $1"; [[ -z "${2:-}" ]] || echo "     $2"; }
# check NAME EXPECTED GOT
check() { if [[ "$2" == "$3" ]]; then pass "$1"; else fail "$1" "expected [$2] got [$3]"; fi; }
refused() { # NAME CMD...
    local name="$1"; shift
    if "$@" >/dev/null 2>&1; then fail "$name" "command succeeded: $*"; else pass "$name"; fi
}
# Mode, owner, group and ACL of a path, without the parts of a listing that
# change when entries are added (link count, size, time).
security_of() { $STAT -f '%Sp %u %g' "$1"; /bin/ls -lde "$1" | /usr/bin/tail -n +2; }

# Host-only scratch (never the workspace).
SCRATCH="$(/usr/bin/mktemp -d)"

cleanup() {
    set +e
    /bin/rm -rf "$SCRATCH"
    # Empty the throwaway workspace (find does not follow links), so that the
    # helper removes the directory too, whichever check the run stopped at.
    [[ -d "$WS" && ! -L "$WS" ]] && /usr/bin/find "$WS" -mindepth 1 -delete 2>/dev/null
    "$SV2" profile remove "$P" >/dev/null 2>&1
}
trap cleanup EXIT

# Run a command in the throwaway profile's sandbox.
sb() { "$SV2" --profile "$P" shell "$@"; }
account_exists() { /usr/bin/dscl . -read "/Users/$ACCOUNT" UniqueID >/dev/null 2>&1; }

###############################################################################
# profile add
###############################################################################
"$SV2" profile add "$P" >/dev/null
check "profile add: listed as active" "active" \
    "$("$SV2" profile list | /usr/bin/awk -v p="$P" '$1 == p {print $2}')"

SB_UID="$(/usr/bin/dscl . -read "/Users/$ACCOUNT" UniqueID | /usr/bin/awk '{print $2}')"
[[ "$SB_UID" =~ ^[0-9]+$ ]] || { echo >&2 "account $ACCOUNT was not created"; exit 1; }
if [[ "$SB_UID" -ge 600 ]]; then pass "account: UID >= 600"; else fail "account: UID >= 600" "$SB_UID"; fi
check "account: primary group is its own" "$SB_UID" \
    "$(/usr/bin/dscl . -read "/Users/$ACCOUNT" PrimaryGroupID | /usr/bin/awk '{print $2}')"
if /usr/bin/id -Gn "$ACCOUNT" | /usr/bin/tr ' ' '\n' | /usr/bin/grep -qx staff; then
    fail "account: not in staff"
else
    pass "account: not in staff"
fi
check "account: no usable password" "*" \
    "$(/usr/bin/dscl . -read "/Users/$ACCOUNT" Password | /usr/bin/awk '{print $2}')"

# SSH: with Remote Login on, an account that sshd accepts could connect to
# itself and get a shell outside its sandbox profile. Every sandbox account is
# in sv2-sandboxes, and the drop-in refuses that group.
if /usr/bin/id -Gn "$ACCOUNT" | /usr/bin/tr ' ' '\n' | /usr/bin/grep -qx sv2-sandboxes; then
    pass "account: in the sv2-sandboxes group"
else
    fail "account: in the sv2-sandboxes group" "$(/usr/bin/id -Gn "$ACCOUNT")"
fi
check "sshd drop-in: root-owned, not writable by others" "0 644" "$($STAT -f '%u %Lp' "$SSHD_DROPIN")"
# Installed files carry the version the helper checks before a session. (The
# sudoers file is not readable from here.)
artifact_version() { /usr/bin/tr ',' '\n' <<<"$VERSION" | /usr/bin/sed -n "s/^$1=//p"; }
check "sshd drop-in: carries its version" "# sv2-sshd-version: $(artifact_version sshd)" \
    "$(/usr/bin/grep -m1 '^# sv2-sshd-version: ' "$SSHD_DROPIN")"
check "sandbox profile: carries its version" ";; sv2-profile-version: $(artifact_version profile)" \
    "$(/usr/bin/grep -m1 '^;; sv2-profile-version: ' "$SB")"
# What sshd itself would apply to a login as USER, read from the system's
# configuration as a whole (so a drop-in that is not included, or is
# overridden, shows). -T needs a host key; a throwaway one will do.
/usr/bin/ssh-keygen -q -t ed25519 -N '' -f "$SCRATCH/hostkey"
sshd_applies() { # USER
    /usr/sbin/sshd -T -h "$SCRATCH/hostkey" -C "user=$1" 2>&1 | /usr/bin/tr '[:upper:]' '[:lower:]' \
        | /usr/bin/grep -xE "$SSHD_REFUSALS" | /usr/bin/sort | /usr/bin/tr '\n' '|'
}
SSHD_REFUSALS='(denygroups sv2-sandboxes|pubkeyauthentication no|authorizedkeysfile none|forcecommand /usr/bin/false)'
check "sshd: refuses a login as the sandbox account" \
    "authorizedkeysfile none|denygroups sv2-sandboxes|forcecommand /usr/bin/false|pubkeyauthentication no|" \
    "$(sshd_applies "$ACCOUNT")"
# Control: the Match block must not reach anyone else. (DenyGroups is a list
# sshd prints for everyone; it only bites members.)
check "sshd: the refusal does not apply to the host user" "denygroups sv2-sandboxes|" "$(sshd_applies "$HOST_USER")"

check "home: owner and mode" "$SB_UID 700" "$($STAT -f '%u %Lp' "/Users/$ACCOUNT")"
check "workspace: owner and mode" "$HOST_UID 700" "$($STAT -f '%u %Lp' "$WS")"
check "workspace parents: root-owned, not writable by others" "0 755 0 755" \
    "$($STAT -f '%u %Lp' /Users/Shared/sv2) $($STAT -f '%u %Lp' "/Users/Shared/sv2/$HOST_USER")"
check "sandbox profile: root-owned, read-only" "0 444" "$($STAT -f '%u %Lp' "$SB")"

if "$SV2" profile add "$P" >/dev/null; then pass "profile add: repeatable"; else fail "profile add: repeatable"; fi
check "profile add: repeat keeps the UID" "$SB_UID" \
    "$(/usr/bin/dscl . -read "/Users/$ACCOUNT" UniqueID | /usr/bin/awk '{print $2}')"

###############################################################################
# sessions
###############################################################################
check "session: runs as the sandbox account" "$ACCOUNT" "$(sb /usr/bin/id -un)"
check "session: no staff, no host groups" "" \
    "$(sb /usr/bin/id -Gn | /usr/bin/tr ' ' '\n' | /usr/bin/grep -xE 'staff|admin|wheel|sv2-users' || true)"
# Acceptance test from the design: the session is in the sandbox user's own
# launchd domain, not the host user's.
check "session: own launchd domain (manageruid == uid)" "$SB_UID" "$(sb /bin/launchctl manageruid)"
check "session: starts in the workspace" "$WS" "$(cd / && sb /bin/pwd)"
# The guest launcher: the session's own bin directories lead PATH, Homebrew
# comes before the system (a login zsh would otherwise put the system first),
# and the startup file that arranges it was written into the sandbox home.
SB_PATH="$(sb /bin/sh -c 'printf %s "$PATH"')"
if [[ "$SB_PATH" == "/Users/$ACCOUNT/.local/bin:/Users/$ACCOUNT/bin:"* ]]; then
    pass "launcher: the account's bin directories lead PATH"
else
    fail "launcher: the account's bin directories lead PATH" "$SB_PATH"
fi
for BREW in /opt/homebrew /usr/local; do
    [[ -x "$BREW/bin/brew" ]] || continue
    if [[ "${SB_PATH%%:/usr/bin:*}" == *":$BREW/bin"* ]]; then
        pass "launcher: Homebrew comes before the system in PATH"
    else
        fail "launcher: Homebrew comes before the system in PATH" "$SB_PATH"
    fi
    break
done
check "launcher: startup files are written into the sandbox home" "yes yes" \
    "$(sb /bin/sh -c 'grep -q "Written once by sandvault2" ~/.zprofile && printf "yes "; test -f ~/.zshrc && printf yes')"
# The helper ignores the terminal's stop signals so that ^Z cannot park it
# with the registry lock held. An ignored signal stays ignored across exec,
# and a session in which ^Z did nothing would be no use.
check "session: can be suspended (stop signals are not ignored)" "default default default" \
    "$(sb /usr/bin/perl -e 'print join(" ", map { ($SIG{$_} // "") eq "IGNORE" ? "ignored" : "default" } qw(TSTP TTIN TTOU))')"
/bin/mkdir "$WS/host dir"
check "session: starts in the host's directory inside the workspace" "$WS/host dir" \
    "$(cd "$WS/host dir" && sb /bin/pwd)"
/bin/rmdir "$WS/host dir"
check "session: HOME" "/Users/$ACCOUNT" "$(sb /bin/sh -c 'echo "$HOME"')"

check "arguments: passed unchanged" 'a b|$HOME|`id`|x;y|q'"'"'"||-l|--|ünï|*|' \
    "$(sb /usr/bin/printf '%s|' 'a b' '$HOME' '`id`' 'x;y' "q'\"" '' -l -- 'ünï' '*')"
rc=0; sb /bin/sh -c 'exit 7' || rc=$?
check "exit status: propagates" "7" "$rc"
check "stdin: piped commands run" "piped-42" "$(echo 'echo piped-$((6*7))' | "$SV2" --profile "$P" shell)"
check "stdin: reaches the command" "HELLO" "$(echo hello | sb /usr/bin/tr a-z A-Z)"

check "environment: host variables do not leak" "" \
    "$(SV2_TEST_LEAK=leaked SSH_AUTH_SOCK=/tmp/x sb /usr/bin/env | /usr/bin/grep -E '^(SV2_TEST_LEAK|SSH_AUTH_SOCK|SUDO_)' || true)"
check "environment: TERM is forwarded" "sv2-test-term" "$(TERM=sv2-test-term sb /bin/sh -c 'echo "$TERM"')"

###############################################################################
# terminal
###############################################################################
# The session must not share the host's terminal: a process holding the host's
# tty can push keystrokes into its input queue (TIOCSTI), and the host shell
# runs them after the session ends. sudo gives the session a pty of its own.
#
# on_pty runs a bash script on a fresh pty. script(1) forwards its stdin to
# the pty and sends EOF when that ends, which a later `read` would see instead
# of injected input. So stdin is a pipe that a sleep holds open (script
# rejects a fifo), and the sleep is killed afterwards.
on_pty() {
    # The holder's stderr is redirected so it does not keep this function's
    # output pipe open.
    SV2="$SV2" P="$P" INJECT="$INJECT" /usr/bin/script -q /dev/null /bin/bash -c "$1" \
        < <(/bin/sh -c 'echo $$ > "$0"; exec /bin/sleep 120' "$SCRATCH/holder.pid" 2>/dev/null) 2>&1 \
        | /usr/bin/tr -d '\r'
    kill "$(/bin/cat "$SCRATCH/holder.pid")" 2>/dev/null || true
}
field() { /usr/bin/sed -n "s/^$1=//p" <<<"$2" | /usr/bin/head -1; }
# 0x80017472 is TIOCSTI.
INJECT='for (split //, qq(sv2-injected\n)) { ioctl(STDIN, 0x80017472, $_) or die qq(TIOCSTI: $!\n) }'

# Control: without sv2 in between, the injection reaches the shell. If this
# fails the probe proves nothing and the check after it must not be believed.
OUT="$(on_pty '/usr/bin/perl -e "$INJECT"; IFS= read -r -t 2 line; echo "host-read=[$line]"')"
check "terminal: control, injection reaches a shell on the same tty" "[sv2-injected]" "$(field host-read "$OUT")"

OUT="$(on_pty '
    /bin/stty rows 41 cols 101
    echo "host-tty=$(/usr/bin/tty)"
    "$SV2" --profile "$P" shell /bin/sh -c '\''echo "sandbox-tty=$(/usr/bin/tty)"; echo "size=$(/bin/stty size)"'\''
    "$SV2" --profile "$P" shell /usr/bin/perl -e "$INJECT"; echo "inject-rc=$?"
    IFS= read -r -t 2 line; echo "host-read=[$line]"
')"
HOST_TTY="$(field host-tty "$OUT")"
SB_TTY="$(field sandbox-tty "$OUT")"
if [[ "$HOST_TTY" == /dev/ttys* && "$SB_TTY" == /dev/ttys* && "$HOST_TTY" != "$SB_TTY" ]]; then
    pass "terminal: the session has its own tty"
else
    fail "terminal: the session has its own tty" "host [$HOST_TTY] sandbox [$SB_TTY]"
fi
check "terminal: window size reaches the session" "41 101" "$(field size "$OUT")"
# inject-rc 0: the ioctl itself worked, so an empty read means the keystrokes
# went to the session's own tty, not that the probe was refused.
check "terminal: session cannot inject input into the host's tty" "0 []" \
    "$(field inject-rc "$OUT") $(field host-read "$OUT")"

# tmux inside the sandbox (design: "Terminal multiplexers"): the server
# outlives the session that started it and a later session attaches to it.
if sb /bin/sh -c 'command -v tmux' >/dev/null 2>&1; then
    sb tmux new-session -d -s sv2test '/bin/sleep 600'
    check "tmux: server outlives the session that started it" "sv2test" \
        "$(sb tmux list-sessions -F '#{session_name}' 2>&1)"
    if /usr/bin/pgrep -u "$SB_UID" -x tmux >/dev/null; then
        pass "tmux: server runs as the sandbox account"
    else
        fail "tmux: server runs as the sandbox account"
    fi
    OUT="$(on_pty '"$SV2" --profile "$P" shell tmux new-session -s sv2attach "echo tmux-says-$((6*7)); /bin/sleep 1"')"
    if [[ "$OUT" == *tmux-says-42* ]]; then
        pass "tmux: a client attaches on the session's tty"
    else
        fail "tmux: a client attaches on the session's tty"
    fi
    sb tmux kill-server 2>/dev/null || true
else
    echo -e "${ORANGE}     tmux is not installed: tmux checks NOT RUN${NC}"
    if [[ "${SV_TESTS_FAIL_ON_SKIP:-0}" == "1" ]]; then
        fail "tmux: checks ran" "tmux not found in the session's PATH"
    fi
fi

###############################################################################
# confinement (judged from the host side)
###############################################################################
MARK="sv2-test-$$-$RANDOM"
check "sandbox: cannot read the host home" "" "$(sb /bin/ls "$HOME" 2>/dev/null || true)"
sb /usr/bin/touch "/Users/Shared/$MARK" 2>/dev/null || true
if [[ -e "/Users/Shared/$MARK" ]]; then
    fail "sandbox: cannot write outside the workspace" "/Users/Shared/$MARK was created"
    /usr/bin/sudo -n -- "$HELPER" call "$VERSION" launch "$P" -- /bin/rm -f "/Users/Shared/$MARK" || true
else
    pass "sandbox: cannot write outside the workspace"
fi
sb /usr/bin/touch "/Users/Shared/sv2/$HOST_USER/$MARK" 2>/dev/null || true
if [[ -e "/Users/Shared/sv2/$HOST_USER/$MARK" ]]; then
    fail "sandbox: cannot create a sibling of the workspace"
else
    pass "sandbox: cannot create a sibling of the workspace"
fi
sb /bin/mv "$WS" "/private/tmp/$MARK" 2>/dev/null || true
if [[ -d "$WS" && ! -e "/private/tmp/$MARK" ]]; then
    pass "sandbox: cannot move the workspace away"
else
    fail "sandbox: cannot move the workspace away"
fi

# The attack the sshd drop-in exists for: the sandbox authorizes a key of its
# own for its own account and logs in to this Mac, which would give it a
# process outside the sandbox profile. Judged by whether the command ran.
# Needs Remote Login to be on; what sshd would decide is checked above either
# way. Where Remote Login is limited to certain users, sshd refuses the
# account for that reason too, and this check cannot tell the two apart.
if /usr/bin/nc -z -G 2 127.0.0.1 22 >/dev/null 2>&1; then
    OUT="$(sb /bin/sh -c '
        mkdir -p ~/.ssh && chmod 700 ~/.ssh && rm -f ~/.ssh/sv2test ~/.ssh/sv2test.pub
        /usr/bin/ssh-keygen -q -t ed25519 -N "" -f ~/.ssh/sv2test
        cat ~/.ssh/sv2test.pub >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys
        /usr/bin/ssh -F /dev/null -i ~/.ssh/sv2test -o IdentitiesOnly=yes -o IdentityAgent=none \
            -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -o ConnectTimeout=10 "$USER@127.0.0.1" /usr/bin/touch "/private/tmp/$1"
    ' sv2 "$MARK-ssh" 2>&1 || true)"
    if [[ "$OUT" == *"Permission denied"* ]]; then
        pass "ssh: precondition, the sandbox's login attempt reached sshd"
    else
        fail "ssh: precondition, the sandbox's login attempt reached sshd" "$OUT"
    fi
    if [[ -e "/private/tmp/$MARK-ssh" ]]; then
        fail "ssh: sandbox cannot log in to its own account" "/private/tmp/$MARK-ssh was created"
        /usr/bin/sudo -n -- "$HELPER" call "$VERSION" launch "$P" -- /bin/rm -f "/private/tmp/$MARK-ssh" || true
    else
        pass "ssh: sandbox cannot log in to its own account"
    fi
else
    echo -e "${ORANGE}     Remote Login is off: the SSH login attempt was NOT RUN${NC}"
    if [[ "${SV_TESTS_FAIL_ON_SKIP:-0}" == "1" ]]; then
        fail "ssh: login attempt ran" "nothing listens on 127.0.0.1 port 22"
    fi
fi

# The sandbox can use the workspace but not re-permission, re-own, delete or
# replace the directory itself. Judged by the directory's mode, owner and ACL
# as the host sees them before and after.
WS_BEFORE="$(security_of "$WS")"
sb /bin/sh -c '
    chmod 777 .
    chmod +a "everyone allow list,search,add_file,delete_child" .
    chmod -N .
    chown "$(id -u)" .
    rmdir "$SV2_WORKSPACE"
    mv "$SV2_WORKSPACE" "$SV2_WORKSPACE.moved"
' >/dev/null 2>&1 || true
check "workspace: sandbox cannot change the directory's mode, owner or ACL" "$WS_BEFORE" "$(security_of "$WS" 2>&1)"
if [[ ! -e "$WS.moved" ]]; then
    pass "workspace: sandbox cannot rename the directory in place"
else
    fail "workspace: sandbox cannot rename the directory in place"
fi

# Entries the sandbox creates as private (umask 077) are still the host
# user's to read and write: access comes from the inherited ACL entries, not
# from the mode bits.
sb /bin/sh -c 'umask 077; mkdir -p private/sub && echo secret > private/sub/file'
check "workspace: sandbox-private entries have no mode bits for the host" "700 600" \
    "$($STAT -f '%Lp' "$WS/private") $($STAT -f '%Lp' "$WS/private/sub/file")"
check "workspace: host can read a sandbox-private file" "secret" "$(/bin/cat "$WS/private/sub/file" 2>&1)"
if echo appended >> "$WS/private/sub/file" && echo from-host > "$WS/private/sub/host-new"; then
    pass "workspace: host can write inside a sandbox-private directory"
else
    fail "workspace: host can write inside a sandbox-private directory"
fi
check "workspace: sandbox sees the host's changes there" "secret appended from-host" \
    "$(sb /bin/sh -c 'cat private/sub/file private/sub/host-new' | /usr/bin/tr '\n' ' ' | /usr/bin/sed 's/ $//')"
# Execute permission is never inherited, in either direction.
sb /bin/sh -c 'printf "#!/bin/sh\necho ran\n" > private/script'
if [[ -r "$WS/private/script" && ! -x "$WS/private/script" ]]; then
    pass "workspace: sandbox-created files are not executable by the host"
else
    fail "workspace: sandbox-created files are not executable by the host"
fi
printf '#!/bin/sh\necho ran\n' > "$WS/private/host-script"
check "workspace: host-created files are not executable by the sandbox" "readable not-executable" \
    "$(sb /bin/sh -c 'test -r private/host-script && echo readable; test -x private/host-script || echo not-executable' | /usr/bin/tr '\n' ' ' | /usr/bin/sed 's/ $//')"
if /bin/rm -f "$WS/private/script" "$WS/private/host-script" "$WS/private/sub/file" "$WS/private/sub/host-new" \
    && /bin/rmdir "$WS/private/sub" "$WS/private"; then
    pass "workspace: host can remove sandbox-private entries"
else
    fail "workspace: host can remove sandbox-private entries"
fi

sb /bin/sh -c 'echo from-sandbox > sandbox-file && mkdir -p d/e && echo x > d/e/f'
if [[ -f "$WS/sandbox-file" && -f "$WS/d/e/f" ]]; then
    pass "workspace: sandbox can create files and directories"
else
    fail "workspace: sandbox can create files and directories"
fi
check "workspace: sandbox files are owned by the sandbox account" "$SB_UID" "$($STAT -f '%u' "$WS/sandbox-file")"
# The host user reaches sandbox-created entries through the inherited ACEs.
if /bin/rm -f "$WS/d/e/f" && /bin/rmdir "$WS/d/e" "$WS/d" && /bin/rm -f "$WS/sandbox-file"; then
    pass "workspace: host can remove what the sandbox created"
else
    fail "workspace: host can remove what the sandbox created"
fi
echo from-host > "$WS/host-file"
check "workspace: sandbox can read and rewrite host files" "from-host" \
    "$(sb /bin/sh -c 'cat host-file && echo changed > host-file')"
if [[ ! -x "$WS/host-file" ]]; then pass "workspace: new files are not executable"; else fail "workspace: new files are not executable"; fi

###############################################################################
# repair
###############################################################################
# Entries with no inherited ACL, as if moved in from elsewhere: host-owned,
# private mode, so the sandbox has no way in.
(
    umask 077
    echo moved-in > "$WS/moved"
    /bin/mkdir -p "$WS/moved-dir/sub"
    echo inner > "$WS/moved-dir/sub/inner"
)
/bin/chmod -R -N "$WS/moved" "$WS/moved-dir"
check "repair: precondition, sandbox cannot open entries without the ACL" "" \
    "$(sb /bin/sh -c 'cat moved moved-dir/sub/inner' 2>/dev/null || true)"
check "repair: a file by absolute path" "repaired 1, already correct 0, skipped 0" "$("$SV2" repair "$WS/moved" 2>&1)"
check "repair: sandbox can read and write the repaired file" "moved-in" \
    "$(sb /bin/sh -c 'cat moved && echo more >> moved' 2>&1)"
check "repair: a directory by relative path, with its contents" "repaired 3, already correct 0, skipped 0" \
    "$(cd "$WS" && "$SV2" repair moved-dir 2>&1)"
check "repair: sandbox can use the repaired directory" "inner" \
    "$(sb /bin/sh -c 'cat moved-dir/sub/inner && echo new > moved-dir/sub/from-sandbox' 2>&1)"
# moved, moved-dir, sub, inner and host-file (from above) are right already.
# from-sandbox is the sandbox account's, and becomes the host user's.
check "repair: sandbox-owned entries are counted as repaired" "repaired 1, already correct 5, skipped 0" \
    "$("$SV2" repair "$WS" 2>&1)"
check "repair: takes ownership for the host user" "$HOST_UID" "$($STAT -f '%u' "$WS/moved-dir/sub/from-sandbox")"
check "repair: the sandbox can still use and chmod what it no longer owns" "new ok" \
    "$(sb /bin/sh -c 'cat moved-dir/sub/from-sandbox && echo more >> moved-dir/sub/from-sandbox && chmod +x moved-dir/sub/from-sandbox && echo ok' 2>&1 \
        | /usr/bin/tr '\n' ' ' | /usr/bin/sed 's/ $//')"
check "repair: a second run changes nothing" "repaired 0, already correct 6, skipped 0" "$("$SV2" repair "$WS" 2>&1)"
check "repair: the workspace directory itself is untouched" "$WS_BEFORE" "$(security_of "$WS" 2>&1)"
/bin/rm -rf "$WS/moved" "$WS/moved-dir"

# The attack: the sandbox plants links to things of the host's outside the
# workspace and waits for the host to run repair. Judged by the targets.
echo secret > "$SCRATCH/victim"
/bin/mkdir "$SCRATCH/victim-dir"
VICTIMS_BEFORE="$(/bin/ls -lde "$SCRATCH" "$SCRATCH/victim" "$SCRATCH/victim-dir")"
sb /bin/sh -c 'ln -s "$1/victim" link-file; ln -s "$1/victim-dir" link-dir; mkdir real; ln -s "$1" real/link-up' sv2 "$SCRATCH"
if [[ -L "$WS/link-file" && -L "$WS/link-dir" && -L "$WS/real/link-up" ]]; then
    pass "repair: precondition, the sandbox planted its links"
else
    fail "repair: precondition, the sandbox planted its links"
fi
"$SV2" repair "$WS" >/dev/null 2>&1 || true
refused "repair: a link named directly is refused" "$SV2" repair "$WS/link-file"
refused "repair: a path through a link is refused" "$SV2" repair "$WS/link-dir/x"
refused "repair: a path through a nested link is refused" "$SV2" repair "$WS/real/link-up/victim"
check "repair: nothing the links point to was changed" "$VICTIMS_BEFORE" \
    "$(/bin/ls -lde "$SCRATCH" "$SCRATCH/victim" "$SCRATCH/victim-dir")"
/bin/rm -rf "$WS/link-file" "$WS/link-dir" "$WS/real"

refused "repair: a path outside any workspace is refused" "$SV2" repair /private/tmp
refused "repair: the host home is refused" "$SV2" repair "$HOME"
refused "repair: the directory above the workspace is refused" "$SV2" repair "/Users/Shared/sv2/$HOST_USER"
refused "repair: '..' is refused" "$SV2" repair "$WS/../$P"
refused "repair: a profile that does not exist is refused" "$SV2" repair "/Users/Shared/sv2/$HOST_USER/nosuchprofile"

# What the host has no right to change is reported, and the exit status says so.
sb /bin/sh -c 'umask 077; echo mine > locked; chmod -N locked'
rc=0; OUT="$("$SV2" repair "$WS" 2>&1)" || rc=$?
if [[ "$rc" -ne 0 && "$OUT" == *"skipped 1"* && "$OUT" == *locked* ]]; then
    pass "repair: an entry it may not change is reported and fails the run"
else
    fail "repair: an entry it may not change is reported and fails the run" "rc=$rc $OUT"
fi
/bin/rm -f "$WS/locked"

###############################################################################
# the helper refuses what it must
###############################################################################
CALL=(/usr/bin/sudo -n -- "$HELPER" call "$VERSION")
# sandbox-exec would read a leading -p as "use this profile instead".
OUT="$("${CALL[@]}" launch "$P" -- -p '(version 1)(allow default)' /usr/bin/touch "/Users/Shared/$MARK" 2>&1 || true)"
if [[ ! -e "/Users/Shared/$MARK" && "$OUT" == *"absolute path"* ]]; then
    pass "helper: command cannot be a sandbox-exec option"
else
    fail "helper: command cannot be a sandbox-exec option" "$OUT"
    /usr/bin/sudo -n -- "$HELPER" call "$VERSION" launch "$P" -- /bin/rm -f "/Users/Shared/$MARK" || true
fi
refused "helper: unknown profile" "${CALL[@]}" launch nosuchprofile -- /usr/bin/true
refused "helper: invalid profile name" "${CALL[@]}" profile-add "../x"
refused "helper: invalid profile name (dash)" "${CALL[@]}" profile-add "a-b"
rc=0; /usr/bin/sudo -n -- "$HELPER" call "${VERSION/sshd=/sshd=9}" profile-list >/dev/null 2>&1 || rc=$?
check "helper: one artifact version that differs is refused, with the reinstall status" "3" "$rc"
refused "helper: the application version is not what it compares" \
    /usr/bin/sudo -n -- "$HELPER" call "$APP_VERSION" profile-list
refused "helper: not runnable without sudo" "$HELPER" call "$VERSION" profile-list
refused "helper: admin verbs are not in call mode" "${CALL[@]}" uninstall
refused "helper: stage2 is not in call mode" "${CALL[@]}" stage2 "$SB_UID" "$HOST_USER" "$P" -- /usr/bin/true
refused "sandbox account: cannot reach the helper through sudo" sb /usr/bin/sudo -n -- "$HELPER" call "$VERSION" profile-list
# The sudoers line covers call mode only. -k ignores a cached sudo password.
# Skipped where the user has blanket passwordless sudo (CI runners).
if /usr/bin/sudo -k -n /usr/bin/true 2>/dev/null; then
    echo "     (blanket passwordless sudo: admin/stage2 password checks not applicable)"
else
    refused "sudoers: admin mode needs a password" \
        /usr/bin/sudo -k -n -- "$HELPER" admin "$VERSION" user-deny sv2-no-such-user
    refused "sudoers: stage2 needs a password" \
        /usr/bin/sudo -k -n -- "$HELPER" stage2 "$SB_UID" "$HOST_USER" "$P" -- /usr/bin/true
fi

# The caller chooses the helper's standard output. A pipe that is already
# full blocks the helper where it prints, for as long as the caller likes;
# the registry lock must not be held there, or everybody else's sv2 waits.
# The first helper lists profiles into a full pipe; the second command needs
# the lock exclusively. "first=blocked" shows the attack was in place.
FULL_PIPE='
use strict; use Fcntl; use POSIX ":sys_wait_h"; use Time::HiRes qw(sleep);
my ($helper, $version, $profile, $sv2) = @ARGV;
pipe(my $r, my $w) or die;
my $fl = fcntl($w, F_GETFL, 0); fcntl($w, F_SETFL, $fl | O_NONBLOCK);
1 while defined(syswrite($w, "x"));
fcntl($w, F_SETFL, $fl);
my $pid = fork;
if (!$pid) { open(STDOUT, ">&", $w) or die; close $r;
  exec "/usr/bin/sudo", "-n", "--", $helper, "call", $version, "profile-list"; die }
sleep 1.5;
my $first = waitpid($pid, WNOHANG) == 0 ? "blocked" : "finished";
my $pid2 = fork;
if (!$pid2) { open(STDOUT, ">", "/dev/null"); open(STDERR, ">", "/dev/null");
  exec $sv2, "profile", "add", $profile; die }
my $second = "waited";
for (1..100) { if (waitpid($pid2, WNOHANG) != 0) { $second = "ran"; last } sleep 0.1 }
kill "KILL", $pid2 if $second eq "waited";
close $w; my $buf; 1 while sysread($r, $buf, 65536);
waitpid($pid, 0); waitpid($pid2, 0) if $second eq "waited";
print "first=$first second=$second";
'
check "helper: printing into a full pipe does not hold the lock" "first=blocked second=ran" \
    "$(/usr/bin/perl -e "$FULL_PIPE" "$HELPER" "$VERSION" "$P" "$SV2")"

###############################################################################
# profile remove
###############################################################################
# A detached process outlives the session, and removal kills it.
sb /bin/sh -c '/usr/bin/nohup /bin/sleep 600 >/dev/null 2>&1 &'
if /usr/bin/pgrep -u "$SB_UID" -x sleep >/dev/null; then
    pass "detached process outlives the session"
else
    fail "detached process outlives the session"
fi
# A private file of the sandbox's, kept across removal (see re-add below).
sb /bin/sh -c 'umask 077; echo kept > sandbox-kept'
# A home laid out to resist deletion: immutable file, unreadable directories.
sb /bin/sh -c 'mkdir -p ~/deep/tree && echo x > ~/deep/tree/file && chflags uchg ~/deep/tree/file && chmod 000 ~/deep/tree ~/deep'

# A fork storm: processes that fork and exit without pause, so that a pass of
# SIGKILL always leaves some that were born during it. It is bounded (400
# processes, by a limit it cannot raise) and ends by itself after a minute,
# whatever becomes of this test. Measured on 2026-11-25: the removal used
# until then (SIGKILL every 100 ms, 20 times) left 391 of these running and
# failed.
STORM='$SIG{HUP}="IGNORE"; my $end=time+60; while (time < $end) { my $p=fork; if (defined $p && $p==0) { srand; next } exit if rand() < 0.2 }'
sb /bin/sh -c 'ulimit -u 400; /usr/bin/perl -e "$1" >/dev/null 2>&1 &' sh "$STORM"
STORM_START="$(/bin/date +%s)"
/bin/sleep 1
STORM_SIZE="$(/bin/ps -u "$SB_UID" -o pid= | /usr/bin/wc -l | /usr/bin/tr -d ' ')"
if [[ "$STORM_SIZE" -ge 300 ]]; then
    pass "fork storm: running before the removal"
else
    fail "fork storm: running before the removal" "only $STORM_SIZE processes"
fi

OUT="$("$SV2" profile remove "$P")" && RC=0 || RC=$?
check "remove: succeeds against a fork storm" "0" "$RC"
if [[ "$RC" -ne 0 ]]; then
    # Let the storm end by itself, then finish the removal, so that the
    # checks below fail for their own reasons only.
    echo "     waiting for the fork storm to end"
    while [[ "$(/bin/date +%s)" -lt $((STORM_START + 62)) ]]; do /bin/sleep 1; done
    OUT="$("$SV2" profile remove "$P")"
fi
if /usr/bin/pgrep -u "$SB_UID" >/dev/null; then fail "remove: kills the account's processes"; else pass "remove: kills the account's processes"; fi
if account_exists; then fail "remove: account deleted"; else pass "remove: account deleted"; fi
if [[ -e "/Users/$ACCOUNT" ]]; then fail "remove: home deleted"; else pass "remove: home deleted"; fi
if [[ -e "$SB" ]]; then fail "remove: sandbox profile deleted"; else pass "remove: sandbox profile deleted"; fi
# The shared group lists members by name; a stale entry would outlive the
# account.
check "remove: account is no longer listed in sv2-sandboxes" "" \
    "$(/usr/bin/dscl . -read /Groups/sv2-sandboxes GroupMembership | /usr/bin/tr ' ' '\n' | /usr/bin/grep -x "$ACCOUNT" || true)"
# host-file is still there: the user's files are never deleted.
if [[ -f "$WS/host-file" && "$OUT" == *"kept $WS"* ]]; then
    pass "remove: non-empty workspace is kept and reported"
else
    fail "remove: non-empty workspace is kept and reported" "$OUT"
fi
# sv2 itself, as the host user, takes over what the removed account owned.
check "remove: kept files become the host user's" "$HOST_UID $HOST_UID" \
    "$($STAT -f '%u' "$WS/sandbox-kept") $($STAT -f '%u' "$WS/host-file")"
check "remove: kept files keep their mode" "600" "$($STAT -f '%Lp' "$WS/sandbox-kept")"
check "remove: no longer listed" "" "$("$SV2" profile list | /usr/bin/awk -v p="$P" '$1 == p')"
refused "remove: no session after removal" "${CALL[@]}" launch "$P" -- /usr/bin/true

# Adding the name again reuses the kept workspace, under a new UID.
"$SV2" profile add "$P" >/dev/null
NEW_UID="$(/usr/bin/dscl . -read "/Users/$ACCOUNT" UniqueID | /usr/bin/awk '{print $2}')"
if [[ "$NEW_UID" =~ ^[0-9]+$ && "$NEW_UID" -gt "$SB_UID" ]]; then
    pass "re-add: UID is not reused"
else
    fail "re-add: UID is not reused" "old $SB_UID new $NEW_UID"
fi
check "re-add: the new account is refused by sshd as well" \
    "authorizedkeysfile none|denygroups sv2-sandboxes|forcecommand /usr/bin/false|pubkeyauthentication no|" \
    "$(sshd_applies "$ACCOUNT")"
# The directory is reused, and 'profile add' rewrites the ACLs of the files
# in it for the new account: no separate repair.
check "re-add: kept workspace directory is reused" "host-file sandbox-kept" \
    "$(sb /bin/ls | /usr/bin/tr '\n' ' ' | /usr/bin/sed 's/ $//')"
check "re-add: the new account can use the kept files at once" "kept changed" \
    "$(sb /bin/sh -c 'cat sandbox-kept host-file && echo more >> sandbox-kept && echo more >> host-file' 2>&1 \
        | /usr/bin/tr '\n' ' ' | /usr/bin/sed 's/ $//')"
check "re-add: nothing is left to repair" "repaired 0, already correct 2, skipped 0" "$("$SV2" repair "$WS" 2>&1)"

# The same when the account went without sv2 seeing it (here: the helper
# called directly), so its files belong to no account when the profile is
# added again.
sb /bin/sh -c 'umask 077; mkdir orphans && echo orphan > orphans/file'
/bin/rm -f "$WS/host-file" "$WS/sandbox-kept"
"${CALL[@]}" profile-remove "$P" >/dev/null
check "re-add: precondition, kept files belong to no account" "$NEW_UID $NEW_UID" \
    "$($STAT -f '%u' "$WS/orphans") $($STAT -f '%u' "$WS/orphans/file")"
OUT="$("$SV2" profile add "$P" 2>&1 >/dev/null)"
if [[ "$OUT" == *"2 kept files and directories made usable"* ]]; then
    pass "re-add: says what it did to the kept files"
else
    fail "re-add: says what it did to the kept files" "$OUT"
fi
check "re-add: files of a vanished account become the host user's" "$HOST_UID $HOST_UID" \
    "$($STAT -f '%u' "$WS/orphans") $($STAT -f '%u' "$WS/orphans/file")"
check "re-add: and the new account can use them" "orphan" \
    "$(sb /bin/sh -c 'cat orphans/file && echo more >> orphans/file' 2>&1)"
/bin/rm -rf "$WS/orphans"
"$SV2" profile remove "$P" >/dev/null
if [[ -e "$WS" ]]; then fail "remove: empty workspace is removed"; else pass "remove: empty workspace is removed"; fi

echo
if [[ "$FAILED" -ne 0 ]]; then
    echo -e "${RED}sv2 integration: $FAILED failed, $PASSED passed${NC}"
    exit 1
fi
echo -e "${GREEN}sv2 integration: $PASSED passed${NC}"
