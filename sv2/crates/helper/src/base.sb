;; Sandbox profile for sandvault2. Rendered by sv2-helper; the placeholders
;; are filled in by sandbox.rs.
;;
;; Default deny. Every allow below names the probe in
;; tests/profile-probes.sh that fails without it, measured under this
;; profile; a rule no probe needs is removed (review-guidelines §3). Later
;; rules win over earlier ones, so the broad allows come first and the denies
;; that cut pieces out of them after.
;;
;; Two things are still as wide as they were, by decision and not by
;; measurement: reading files (everything but the places denied below) and
;; the network (everything). Narrowing either is separate work.
(version 1)
;; sv2-profile-version: __PROFILE_VERSION__
(deny default)

;; Reading files. Without it nothing starts at all: the dynamic linker
;; cannot read a program.
(allow file-read*)

;; The network, unrestricted. Probes: DNS, https with curl, git over https,
;; listen on localhost.
(allow network*)

;; kill and the shell's job control. Probe "signals to own processes": kill
;; fails with "Operation not permitted". Whom a signal may go to is the
;; kernel's ordinary rule: processes of the same user.
(allow signal)

;; Terminals: tmux, script, an editor's terminal, an agent's shell tool.
;; Probes "open a pty" and "tmux server" (forkpty fails without it).
(allow pseudo-tty)
;; ioctl on devices the session can open: terminal sizes and modes. Probe
;; "open a pty".
(allow file-ioctl
    (subpath "/dev"))

;; POSIX shared memory and semaphores. Probe "shared memory and semaphores
;; (python)": multiprocessing's Lock and Queue fail to be created.
(allow ipc-posix-shm*)
(allow ipc-posix-sem*)

;; No reading of /Volumes, where removable and network disks appear; the
;; main disk stays readable under its name there. Probe "read /Volumes".
(deny file-read*
    (subpath "/Volumes"))
(allow file-read*
    (subpath "/Volumes/Macintosh HD"))

;; Mach services: only the ones a session needs. Sessions run in the
;; sandvault user's own launchd domain (user/<uid>), which sv2-helper enters
;; with "launchctl asuser". So a per-user agent name allowed here reaches the
;; sandvault user's own agent, not the host user's; launchctl manageruid in
;; a session prints the sandvault uid.
;;
;; Each name was measured by removing it and running the probes. Removed on
;; 2026-11-26 because no probe failed without them: com.apple.cfprefsd
;; (defaults falls back to the file), com.apple.ocspd, com.apple.dnssd,
;; com.apple.mDNSResponder, com.apple.networkd and
;; com.apple.SystemConfiguration (names resolve and connections are made
;; without them).
(allow mach-lookup
  ;; opendirectoryd's libinfo, which carries user and group names. Probes
  ;; "id shows names" (id prints a number) and "ssh-keygen" ("No user exists
  ;; for uid").
  (global-name-prefix "com.apple.system.")
  ;; TLS trust evaluation for curl, git and python. Probe "https with curl
  ;; (TLS trust)": (60) unable to get local issuer certificate; a dozen
  ;; other probes fail with it.
  (global-name "com.apple.TrustEvaluationAgent")
  ;; The same for Go programs, which verify through the per-user trustd
  ;; agent. Probe "Go program verifies TLS (gh)": x509: OSStatus -26276.
  ;; Only the agent's name, not the com.apple.trustd prefix.
  (global-name "com.apple.trustd.agent")
  ;; Keychains, by security and by agents that keep credentials in one.
  ;; securityd is a system daemon and keys its state on the caller's audit
  ;; session, which in user/<uid> is the sandvault user's own. Probe
  ;; "keychain create and use": SecKeychainCreate fails.
  (global-name "com.apple.SecurityServer")
  ;; File system change notifications. fseventsd is a root system daemon,
  ;; not a per-user host service. Probe "file watcher sees a change
  ;; (FSEvents)": the watcher starts and never fires.
  (global-name "com.apple.FSEvents"))

;; Chromium run headless, as Playwright runs it: its "headless shell" build,
;; started with --no-sandbox. (The browser's own sandbox cannot be set up
;; inside this one, "sandbox initialization failed", and this one is what
;; confines it.) Probe "Playwright's headless Chromium loads a page".
;;
;; The browser process and its children (renderer, GPU, utility) find each
;; other through a Mach service the browser registers under its bundle id
;; and process ID. Without the registration, which default deny refuses
;; like any other, the browser stops at "bootstrap_check_in
;; org.chromium.Chromium.MachPortRendezvousServer.N: Permission denied
;; (1100)"; without the lookup its children cannot reach it. The names are
;; made up per launch and carry no authority of the host user.
;;
;; Not here, because no probe passes with them yet: the full applications
;; (Google Chrome, Chrome for Testing). Measured on 2026-11-26, they need
;; their own rendezvous prefixes (com.google.Chrome.,
;; com.google.chrome.for.testing.), org.chromium.crashpad.,
;; com.apple.coreservices.launchservicesd and the IOKit clients
;; IOSurfaceRootUserClient and AGXDeviceUserClient, and with all of those
;; still loaded a page only some of the time.
(allow mach-lookup mach-register
  (global-name-prefix "org.chromium.Chromium.MachPortRendezvousServer."))

;; Keep these four denied explicitly, after the allow above, so that widening
;; the allow later cannot quietly re-admit them.
;; diskarbitrationd -- diskutil mount, hdiutil attach, Finder disk handling
;; NetAuthAgent     -- NetFS: 'open smb://...', Connect to Server
;; NetAuthSysAgent
;; appleeventsd     -- disallow osascript telling Finder to do it
(deny mach-lookup
  (global-name "com.apple.DiskArbitration.diskarbitrationd")
  (global-name "com.apple.NetAuthAgent")
  (global-name "com.apple.NetAuthSysAgent")
  (global-name "com.apple.appleeventsd"))

;; Block raw disk and packet-capture devices regardless of the broader
;; /dev write allow below. Defense in depth: /dev/*disk* is already
;; root:operator 640, but this removes reliance on POSIX perms alone.
(deny file-read* file-write*
    (regex #"^/dev/r?disk")
    (regex #"^/private/dev/r?disk")
    (regex #"^/dev/bpf"))

;; Default-deny reads under /Users, then re-allow only the sandvault
;; user's home and its shared workspace. Catches the host user's home
;; plus any other accounts on the machine (other users, /Users/Guest,
;; sibling sv-* workspaces under /Users/Shared) without enumeration.
;; Last-match-wins, so the re-allows below must follow this deny.
;;
;; The literal re-allows on /Users, /Users/Shared and the two root-owned
;; parents of the workspace grant lookup of
;; those directory entries themselves so that path resolution into the
;; allowed subpaths works. Without them, mkdir -p and open() under
;; the allowed subtrees fail because path traversal touches the denied
;; parent components.
(deny file-read*
    (subpath "/Users"))
(allow file-read*
    (literal "/Users")
    (literal "/Users/Shared")
    (literal "__WORKSPACE_ROOT__")
    (literal "__WORKSPACE_USER_DIR__")
    (subpath "__WORKSPACE__")
    (subpath "__HOME__"))

;; Deny /Library/Keychains, then re-allow only System.keychain.
;; The other keychains there hold user and system secrets, and unlike
;; /dev/*disk* they are not protected by restrictive file permissions
;; (System.keychain itself is mode 644), so this deny is the only thing
;; keeping the sandvault user out of them.
;; System.keychain is re-allowed because it holds the CA trust anchors
;; that tools like LightPanda need to validate TLS connections; its
;; contents are public certificates, not secrets.
(deny file-read*
    (subpath "/Library/Keychains"))
(allow file-read*
    (literal "/Library/Keychains/System.keychain"))

;; Writing: the sandbox home, the workspace, and the temporary directories.
;; Probes "write in the home", "write in the workspace", "write in TMPDIR",
;; "write in /tmp"; "write outside" checks that nothing else is writable.
;; /dev: writing to /dev/null and to the session's terminal. Probe
;; "/dev/null, /dev/urandom"; without it nothing can discard output. Which
;; devices can be written is the devices' own permissions, apart from the
;; raw disks and bpf denied above.
(allow file-write*
    (subpath "__WORKSPACE__")
    (subpath "__HOME__")
    (subpath "/tmp")
    (subpath "/private/tmp")
    (subpath "/var/folders")
    (subpath "/private/var/folders")
    (subpath "/dev"))

;; Reading kernel state: the number of processors, the page size, the OS
;; version. Probe "sysctl reads"; and without it nothing runs at all (every
;; program fails in sysconf).
(allow sysctl-read)

;; Starting programs. Probe "fork and exec, pipes".
(allow process*)

;; /bin/ps is setuid root and does not run under a sandbox: probe "ps shows
;; this process" fails with "Operation not permitted". It runs without one;
;; it shows what any user of this Mac can see.
(allow process-exec
    (literal "/bin/ps")
    (with no-sandbox))
