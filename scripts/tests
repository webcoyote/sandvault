            pass "sv-clone --help shows usage"
        else
            fail "sv-clone --help shows usage" "exit 0 with Usage" "$status | $output"
        fi
    }
    queue_test test_sv_clone_help

    # Clone tests below share the same destination repo name ("sandvault")
    # and race if parallelized.
    wait_for_all_running_tests

    # Test that sv-clone does not generate a deploy key or touch the origin
    # remote unless -k/-w is given.
    test_sv_clone_no_flag_no_deploy_key() {
        local src_repository clone_path key_file origin_after output status
        local github_path="sv-test-org/no-flag-test" repo_name
        local expected_origin="git@github.com:${github_path}.git"

        make_test_repo src_repository "$github_path"
        repo_name="$(basename "$src_repository")"
        clone_path="$CLONE_WORKSPACE/repos/$repo_name"
        key_file="$CLONE_WORKSPACE/_sandvault/.ssh/deploy_$repo_name"

        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        sv_cmd s -- rm -f "$key_file" "$key_file.pub" >/dev/null 2>&1

        set +e
        output=$(sv_clone_cmd "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-clone default clone generates no deploy key" "exit 0" "$status | $output"
            return
        fi

        origin_after=$(git -C "$clone_path" config remote.origin.url 2>/dev/null || true)
        if [[ "$origin_after" != "$expected_origin" ]]; then
            fail "sv-clone default clone leaves origin untouched" "$expected_origin" "$origin_after"
            return
        fi

        if [[ -f "$key_file" ]]; then
            fail "sv-clone default clone generates no deploy key" "no key file" "$key_file exists"
            return
        fi

        pass "sv-clone default clone generates no deploy key and leaves origin untouched"
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
    }
    queue_test test_sv_clone_no_flag_no_deploy_key
    wait_for_all_running_tests

    # Test that -k generates a read-only deploy key, rewrites the origin to
    # SSH, does not request write access, and is idempotent on re-run.
    test_sv_clone_dash_k_read_only() {
        local src_repository clone_path key_file stub_dir log_file state_file
        local github_path="sv-test-org/key-ro-test" repo_name
        local expected_ssh="git@github.com:${github_path}.git"
        local output status origin_after ssh_command add_line

        make_test_repo src_repository "$github_path"
        repo_name="$(basename "$src_repository")"
        clone_path="$CLONE_WORKSPACE/repos/$repo_name"
        key_file="$CLONE_WORKSPACE/_sandvault/.ssh/deploy_$repo_name"
        stub_dir="$(mktemp -d)"
        log_file="$(mktemp)"
        state_file="$(mktemp)"

        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        sv_cmd s -- rm -f "$key_file" "$key_file.pub" >/dev/null 2>&1

        make_gh_stub "$stub_dir"
        export GH_STUB_LOG="$log_file"
        export GH_STUB_STATE="$state_file"

        set +e
        output=$(PATH="$stub_dir:$PATH" sv_clone_cmd -k "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-clone -k generates a read-only deploy key" "exit 0" "$status | $output"
            return
        fi

        if [[ ! -f "$key_file" ]]; then
            fail "sv-clone -k generates a deploy key file" "$key_file exists" "not found"
            return
        fi

        origin_after=$(git -C "$clone_path" config remote.origin.url 2>/dev/null || true)
        if [[ "$origin_after" != "$expected_ssh" ]]; then
            fail "sv-clone -k rewrites origin to SSH" "$expected_ssh" "$origin_after"
            return
        fi

        ssh_command=$(git -C "$clone_path" config core.sshCommand 2>/dev/null || true)
        if [[ "$ssh_command" != *"$key_file"* ]]; then
            fail "sv-clone -k configures core.sshCommand" "*$key_file*" "$ssh_command"
            return
        fi

        add_line=$(grep -F 'deploy-key add' "$log_file" | tail -1)
        if [[ "$add_line" == *"--allow-write"* ]]; then
            fail "sv-clone -k does not request write access" "no --allow-write" "$add_line"
            return
        fi

        # The uploaded file must be a host-owned copy: a path in the
        # sandbox-writable workspace can be swapped before gh reads it.
        if [[ "$add_line" == *"$CLONE_WORKSPACE"* ]]; then
            fail "sv-clone -k uploads a host-owned copy of the key" "no workspace path" "$add_line"
            return
        fi
        if [[ "$(awk '{print $1, $2}' "$state_file.received" 2>/dev/null)" != "$(awk '{print $1, $2}' "$key_file.pub")" ]]; then
            fail "sv-clone -k uploads the installed key" "$(cat "$key_file.pub")" \
                "$(cat "$state_file.received" 2>/dev/null)"
            return
        fi

        # Re-running -k against a repo whose key is already registered
        # (per the stub's state file) should still (re)activate the SSH
        # origin and sshCommand — idempotent, not a silent no-op.
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1

        set +e
        output=$(PATH="$stub_dir:$PATH" sv_clone_cmd -k "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-clone -k re-run is idempotent" "exit 0" "$status | $output"
            return
        fi
        origin_after=$(git -C "$clone_path" config remote.origin.url 2>/dev/null || true)
        ssh_command=$(git -C "$clone_path" config core.sshCommand 2>/dev/null || true)
        if [[ "$origin_after" != "$expected_ssh" || -z "$ssh_command" ]]; then
            fail "sv-clone -k re-run reactivates existing key" "origin rewritten + sshCommand set" "$origin_after | $ssh_command"
            return
        fi

        pass "sv-clone -k generates read-only key, rewrites origin, is idempotent"
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        rm -rf "$stub_dir" "$log_file" "$state_file" "$state_file.received"
    }
    queue_test test_sv_clone_dash_k_read_only
    wait_for_all_running_tests

    # The sandbox can plant symlinks at the deploy key paths. sv-clone runs as
    # the host user, so if it wrote or read through them the sandbox could
    # overwrite any host file (e.g. ~/.ssh/authorized_keys with a key whose
    # private half it holds) or upload a host file to GitHub. The key must be
    # installed by the sandbox, replacing the links rather than following them.
    test_sv_clone_deploy_key_ignores_planted_symlinks() {
        local src_repository clone_path key_file stub_dir log_file state_file
        local github_path="sv-test-org/key-symlink-test" repo_name
        local victim victim_dir output status installed_pub

        make_test_repo src_repository "$github_path"
        repo_name="$(basename "$src_repository")"
        clone_path="$CLONE_WORKSPACE/repos/$repo_name"
        key_file="$CLONE_WORKSPACE/_sandvault/.ssh/deploy_$repo_name"
        stub_dir="$(mktemp -d)"
        log_file="$(mktemp)"
        state_file="$(mktemp)"
        victim_dir="$(mktemp -d)"
        victim="$victim_dir/authorized_keys"
        echo "ORIGINAL" > "$victim"

        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        sv_cmd s -- rm -f "$key_file" "$key_file.pub" >/dev/null 2>&1
        ln -s "$victim_dir/created" "$key_file"   # dangling: looks like "no key yet"
        ln -s "$victim" "$key_file.pub"

        make_gh_stub "$stub_dir"
        export GH_STUB_LOG="$log_file"
        export GH_STUB_STATE="$state_file"

        set +e
        output=$(PATH="$stub_dir:$PATH" sv_clone_cmd -k "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "deploy key install ignores planted symlinks" "exit 0" "$status | $output"
            rm -rf "$stub_dir" "$log_file" "$state_file"* "$victim_dir"; return
        fi
        if [[ "$(cat "$victim")" != "ORIGINAL" || -e "$victim_dir/created" ]]; then
            fail "deploy key install ignores planted symlinks" \
                "symlink targets untouched" "$(cat "$victim"); created=$(ls "$victim_dir")"
            rm -rf "$stub_dir" "$log_file" "$state_file"* "$victim_dir"; return
        fi
        if [[ -L "$key_file" || -L "$key_file.pub" || ! -f "$key_file" ]]; then
            fail "deploy key install ignores planted symlinks" \
                "links replaced by real key files" "$(ls -l "$key_file" "$key_file.pub" 2>&1)"
            rm -rf "$stub_dir" "$log_file" "$state_file"* "$victim_dir"; return
        fi
        installed_pub="$(awk '{print $1, $2}' "$key_file.pub")"

        # Existing key, .pub re-pointed at a host file: the upload must come
        # from the private half (read via the sandbox), not the planted file.
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        sv_cmd s -- rm -f "$key_file.pub" >/dev/null 2>&1
        ln -s "$victim" "$key_file.pub"
        : > "$state_file"; rm -f "$state_file.received"
        set +e
        output=$(PATH="$stub_dir:$PATH" sv_clone_cmd -k "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 || "$(cat "$state_file.received" 2>/dev/null)" != "$installed_pub" ]]; then
            fail "existing deploy key is read via the sandbox" \
                "exit 0, uploaded $installed_pub" "$status | $(cat "$state_file.received" 2>/dev/null) | $output"
            rm -rf "$stub_dir" "$log_file" "$state_file"* "$victim_dir"; return
        fi

        pass "deploy key install and upload never follow planted symlinks"
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        sv_cmd s -- rm -f "$key_file" "$key_file.pub" >/dev/null 2>&1
        rm -rf "$stub_dir" "$log_file" "$state_file"* "$victim_dir"
    }
    queue_test test_sv_clone_deploy_key_ignores_planted_symlinks
    wait_for_all_running_tests

    # sv-clone --profile NAME clones into that profile's workspace, so the
    # in-sandbox fetch on a re-run must run as that profile's sandbox user.
    # Without --profile, sv falls back to the default sandbox user, which
    # can't reach the profile's clone (or runs git as the wrong user). A
    # stub sv next to a copy of sv-clone records how sv is invoked.
    test_sv_clone_fetch_uses_profile() {
        local src_repository install_dir log_file output status fetch_line
        local profile="svtestprofile"

        make_test_repo src_repository "sv-test-org/profile-fetch-test"
        install_dir="$(mktemp -d)"
        log_file="$(mktemp)"
        cp "$SV_CLONE_BASE" "$install_dir/sv-clone"
        cp -R "$SCRIPT_DIR/../helpers" "$install_dir/helpers"
        # shellcheck disable=SC2016 # expanded by the stub, not here
        printf '#!/bin/bash\necho "sv $*" >> "$SV_STUB_LOG"\n' > "$install_dir/sv"
        # shellcheck disable=SC2016 # expanded by the stub, not here
        printf '#!/bin/bash\necho "chgrp $*" >> "$SV_STUB_LOG"\n' > "$install_dir/chgrp"
        chmod +x "$install_dir/sv" "$install_dir/chgrp"

        # First run clones (no fetch); the re-run takes the fetch path.
        set +e
        output=$(for _ in 1 2; do
            PATH="$install_dir:$PATH" SV_STUB_LOG="$log_file" \
                SV_CLONE_WORKSPACE_ROOT="$CLONE_WORKSPACE" \
                "$bash_path" "$install_dir/sv-clone" --profile "$profile" "$src_repository" \
                -- --no-build shell -- true || exit $?
        done 2>&1)
        status=$?
        set -e
        fetch_line="$(grep -F 'git fetch' "$log_file" | tail -1)"
        if [[ "$status" -ne 0 || "$fetch_line" != "sv --profile $profile --no-build shell "*" -- git fetch "* ]]; then
            fail "sv-clone re-run fetches as the --profile sandbox user" \
                "sv --profile $profile --no-build shell ... -- git fetch ..." \
                "$status | ${fetch_line:-no fetch} | $output"
            rm -rf "$install_dir" "$log_file" "$CLONE_WORKSPACE/repos/$(basename "$src_repository")"
            return
        fi

        # The bundle dir is 0750, so it must belong to the profile's group or
        # the profile's sandbox user can't read the bundle it's told to fetch.
        if ! grep -q "^chgrp -R sandvault-.*-$profile " "$log_file"; then
            fail "sv-clone re-run bundle is readable by the --profile sandbox user" \
                "chgrp -R sandvault-<user>-$profile ..." "$(grep '^chgrp' "$log_file")"
            rm -rf "$install_dir" "$log_file"
            sv_cmd s -- rm -rf "$CLONE_WORKSPACE/repos/$(basename "$src_repository")" >/dev/null 2>&1
            return
        fi

        pass "sv-clone re-run fetches as the --profile sandbox user"
        rm -rf "$install_dir" "$log_file"
        sv_cmd s -- rm -rf "$CLONE_WORKSPACE/repos/$(basename "$src_repository")" >/dev/null 2>&1
    }
    queue_test test_sv_clone_fetch_uses_profile
    wait_for_all_running_tests

    # sv-gh-token installs a fine-grained GitHub token into the sandbox's gh.
    # The token must reach the sandbox only on stdin (never argv), be stored
    # by the sandbox user's own gh, keep git on SSH deploy keys, and use the
    # --profile sandbox. Classic tokens (repo scope = write everywhere) and
    # tokens with shell metacharacters must be refused before sv is run. A
    # stub sv next to a copy of the script records argv and stdin.
    test_sv_gh_token() {
        local install_dir log_file output status
        # Fake tokens are assembled at runtime so secret scanners see no literal.
        local pat="github""_pat_" classic="gh""p_"
        local token="${pat}AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA_svtest"
        local profile="svtestprofile"

        install_dir="$(mktemp -d)"
        log_file="$(mktemp)"
        cp "$SCRIPT_DIR/../sv-gh-token" "$install_dir/sv-gh-token"
        cp -R "$SCRIPT_DIR/../helpers" "$install_dir/helpers"
        # shellcheck disable=SC2016 # expanded by the stub, not here
        printf '#!/bin/bash\necho "ARGV: $*" >> "$SV_STUB_LOG"\ncat >> "$SV_STUB_LOG"\n' > "$install_dir/sv"
        chmod +x "$install_dir/sv"

        set +e
        output=$(printf ' %s \n' "$token" | SV_STUB_LOG="$log_file" \
            "$bash_path" "$install_dir/sv-gh-token" --profile "$profile" 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-gh-token installs a piped token" "exit 0" "$status | $output"
        elif grep '^ARGV:' "$log_file" | grep -qF "$token"; then
            fail "sv-gh-token keeps the token out of argv" "token only on stdin" "$(cat "$log_file")"
        elif ! grep -qx "ARGV: --profile $profile --no-build shell /Users/Shared/sv-$HOST_USER-$profile" "$log_file"; then
            fail "sv-gh-token runs in the --profile sandbox" \
                "ARGV: --profile $profile --no-build shell /Users/Shared/sv-$HOST_USER-$profile" "$(grep '^ARGV:' "$log_file")"
        elif ! grep -qx "$token" "$log_file" \
            || ! grep -q '^gh auth login --hostname github.com --with-token --insecure-storage --git-protocol ssh --skip-ssh-key <<' "$log_file"; then
            fail "sv-gh-token hands the trimmed token to gh auth login on stdin" \
                "gh auth login ... --git-protocol ssh <<heredoc with token" "$(cat "$log_file")"
        elif grep -q 'setup-git' "$log_file"; then
            fail "sv-gh-token does not make gh a git credential helper" "no setup-git" "$(cat "$log_file")"
        else
            status=ok
        fi
        # One result per test: a later pass would overwrite this failure.
        if [[ "$status" != ok ]]; then
            rm -rf "$install_dir" "$log_file"
            return
        fi

        local bad
        # shellcheck disable=SC2016 # literal $( ) is the malformed token under test
        for bad in "${classic}aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" "${pat}"'aaaaaaaaaaaaaaaaaaaaaaaa$(touch /tmp/x)' ""; do
            : > "$log_file"
            set +e
            output=$(printf '%s\n' "$bad" | SV_STUB_LOG="$log_file" \
                "$bash_path" "$install_dir/sv-gh-token" 2>&1)
            status=$?
            set -e
            if [[ "$status" -eq 0 || -s "$log_file" ]]; then
                fail "sv-gh-token refuses token '${bad:0:16}...' before running sv" \
                    "non-zero exit, sv not run" "$status | $output | $(cat "$log_file")"
                rm -rf "$install_dir" "$log_file"
                return
            fi
        done
        pass "sv-gh-token installs a token via stdin and refuses classic/malformed ones"
        rm -rf "$install_dir" "$log_file"
    }
    queue_test test_sv_gh_token
    wait_for_all_running_tests

    # Test that -w generates a deploy key with write access.
    test_sv_clone_dash_w_write() {
        local src_repository clone_path key_file stub_dir log_file state_file
        local github_path="sv-test-org/key-write-test" repo_name
        local output status add_line

        make_test_repo src_repository "$github_path"
        repo_name="$(basename "$src_repository")"
        clone_path="$CLONE_WORKSPACE/repos/$repo_name"
        key_file="$CLONE_WORKSPACE/_sandvault/.ssh/deploy_$repo_name"
        stub_dir="$(mktemp -d)"
        log_file="$(mktemp)"
        state_file="$(mktemp)"

        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        sv_cmd s -- rm -f "$key_file" "$key_file.pub" >/dev/null 2>&1

        make_gh_stub "$stub_dir"
        export GH_STUB_LOG="$log_file"
        export GH_STUB_STATE="$state_file"

        set +e
        output=$(PATH="$stub_dir:$PATH" sv_clone_cmd -w "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-clone -w requests write access" "exit 0" "$status | $output"
            return
        fi

        add_line=$(grep -F 'deploy-key add' "$log_file" | tail -1)
        if [[ "$add_line" != *"--allow-write"* ]]; then
            fail "sv-clone -w requests write access" "--allow-write present" "$add_line"
            return
        fi

        pass "sv-clone -w requests write access from GitHub"
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        rm -rf "$stub_dir" "$log_file" "$state_file"
    }
    queue_test test_sv_clone_dash_w_write
    wait_for_all_running_tests

    # Test that re-running with -w over an existing -k clone upgrades the
    # deploy key to write access (delete + re-add) without regenerating the
    # local private key.
    test_sv_clone_dash_w_upgrades_read_only_key() {
        local src_repository clone_path key_file stub_dir log_file state_file
        local github_path="sv-test-org/key-upgrade-test" repo_name
        local output status key_hash_before key_hash_after

        make_test_repo src_repository "$github_path"
        repo_name="$(basename "$src_repository")"
        clone_path="$CLONE_WORKSPACE/repos/$repo_name"
        key_file="$CLONE_WORKSPACE/_sandvault/.ssh/deploy_$repo_name"
        stub_dir="$(mktemp -d)"
        log_file="$(mktemp)"
        state_file="$(mktemp)"

        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        sv_cmd s -- rm -f "$key_file" "$key_file.pub" >/dev/null 2>&1

        make_gh_stub "$stub_dir"
        export GH_STUB_LOG="$log_file"
        export GH_STUB_STATE="$state_file"

        set +e
        output=$(PATH="$stub_dir:$PATH" sv_clone_cmd -k "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 || ! -f "$key_file" ]]; then
            fail "sv-clone -k seeds a read-only key for the upgrade test" "exit 0 + key file" "$status | $output"
            return
        fi
        key_hash_before=$(shasum "$key_file" | awk '{print $1}')

        # Remove only the local clone (not the deploy key or stub state)
        # before re-running with -w.
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1

        : > "$log_file"
        set +e
        output=$(PATH="$stub_dir:$PATH" sv_clone_cmd -w "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-clone -w upgrades an existing read-only key" "exit 0" "$status | $output"
            return
        fi

        key_hash_after=$(shasum "$key_file" | awk '{print $1}')
        if [[ "$key_hash_before" != "$key_hash_after" ]]; then
            fail "sv-clone -w upgrade reuses the local keypair" "$key_hash_before" "$key_hash_after"
            return
        fi

        if ! grep -q 'deploy-key delete' "$log_file"; then
            fail "sv-clone -w upgrade deletes the old read-only key" "deploy-key delete recorded" "$(cat "$log_file")"
            return
        fi
        if ! grep -F 'deploy-key add' "$log_file" | grep -q -- '--allow-write'; then
            fail "sv-clone -w upgrade re-adds the key with write access" "--allow-write recorded" "$(cat "$log_file")"
            return
        fi

        pass "sv-clone -w upgrades an existing read-only key to write access"
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        rm -rf "$stub_dir" "$log_file" "$state_file"
    }
    queue_test test_sv_clone_dash_w_upgrades_read_only_key
    wait_for_all_running_tests

    # Re-running sv-clone on an existing clone is a normal host workflow, but
    # the sandbox can write the clone's .git/config between runs. Plant both
    # attacks, then re-run as the host:
    #   - core.alternateRefsCommand (plus an alternates file) runs a command
    #     during fetch. It must never run as the host user, or any guest can
    #     escape the sandbox by waiting for the next sv-clone.
    #   - remote.origin.url aimed at another GitHub repo must not redirect the
    #     deploy key (and, with -w, write access) to that repo.
    test_sv_clone_rerun_ignores_guest_config() {
        local src_repository clone_path key_file stub_dir log_file state_file
        local marker_dir alt_repo expected_repo_path output status
        local github_path="sv-test-org/rerun-test"
        local repo_name

        make_test_repo src_repository "$github_path"
        repo_name="$(basename "$src_repository")"
        clone_path="$CLONE_WORKSPACE/repos/$repo_name"
        key_file="$CLONE_WORKSPACE/_sandvault/.ssh/deploy_$repo_name"
        expected_repo_path="$github_path"
        stub_dir="$(mktemp -d)"
        log_file="$(mktemp)"
        state_file="$(mktemp)"
        # World-writable (sticky) so the planted command can leave a marker
        # whichever account it runs as.
        marker_dir="$(mktemp -d /tmp/sv-clone-marker.XXXXXX)"
        chmod 1777 "$marker_dir"
        alt_repo="$CLONE_WORKSPACE/alt.git"

        sv_cmd s -- rm -rf "$clone_path" "$alt_repo" >/dev/null 2>&1
        sv_cmd s -- rm -f "$key_file" "$key_file.pub" >/dev/null 2>&1

        set +e
        output=$(sv_clone_cmd "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-clone re-run ignores guest config" "initial clone exits 0" "$status | $output"
            return
        fi

        # Poison the clone as the sandbox user (since the clone is now
        # sandbox-owned after the security fix to sv-clone).
        {
            echo "set -e"
            echo "git init -q --bare '$alt_repo'"
            echo "echo '$alt_repo/objects' > '$clone_path/.git/objects/info/alternates'"
            echo "git -C '$clone_path' config core.alternateRefsCommand \"sh -c 'touch \\\"$marker_dir/\\\${SV_CLONE_TEST_CONTEXT:-sandbox}\\\"' x\""
            echo "git -C '$clone_path' config remote.origin.url 'git@github.com:sv-test-attacker/evil.git'"
        } | sv_cmd s

        make_gh_stub "$stub_dir"
        export GH_STUB_LOG="$log_file"
        export GH_STUB_STATE="$state_file"

        set +e
        output=$(SV_CLONE_TEST_CONTEXT=host PATH="$stub_dir:$PATH" \
            sv_clone_cmd -k "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-clone re-run ignores guest config" "re-run exits 0" "$status | $output"
            return
        fi

        if [[ -e "$marker_dir/host" ]]; then
            fail "sv-clone re-run never runs guest-configured commands as the host" \
                "no $marker_dir/host" "planted core.alternateRefsCommand ran in sv-clone's host context"
            return
        fi

        if grep -q 'sv-test-attacker' "$log_file" || ! grep -q -- "-R $expected_repo_path" "$log_file"; then
            fail "sv-clone re-run takes the deploy-key repo from host input" \
                "gh calls only for $expected_repo_path" "$(cat "$log_file")"
            return
        fi

        pass "sv-clone re-run ignores guest-written repo config"
        sv_cmd s -- rm -rf "$clone_path" "$alt_repo" >/dev/null 2>&1
        sv_cmd s -- rm -f "$key_file" "$key_file.pub" >/dev/null 2>&1
        rm -rf "$stub_dir" "$log_file" "$state_file" "$marker_dir"
    }
    queue_test test_sv_clone_rerun_ignores_guest_config
    wait_for_all_running_tests

    # Test that -k with no gh CLI on PATH prints the public key for manual
    # setup and does not rewrite the origin to SSH.
    test_sv_clone_dash_k_no_gh() {
        local src_repository clone_path key_file no_gh_path output status origin_after
        local github_path="sv-test-org/no-gh-test" repo_name
        local expected_origin="git@github.com:${github_path}.git"
        local dir path_dirs

        make_test_repo src_repository "$github_path"
        repo_name="$(basename "$src_repository")"
        clone_path="$CLONE_WORKSPACE/repos/$repo_name"
        key_file="$CLONE_WORKSPACE/_sandvault/.ssh/deploy_$repo_name"

        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
        sv_cmd s -- rm -f "$key_file" "$key_file.pub" >/dev/null 2>&1

        # Build a PATH identical to the current one but with any directory
        # that also provides `gh` removed, so every other tool sv-clone
        # needs (git, ssh-keygen, mkdir, ...) is still found normally.
        no_gh_path=""
        IFS=':' read -ra path_dirs <<< "$PATH"
        for dir in "${path_dirs[@]}"; do
            if [[ ! -x "$dir/gh" ]]; then
                no_gh_path="${no_gh_path:+$no_gh_path:}$dir"
            fi
        done

        set +e
        output=$(PATH="$no_gh_path" sv_clone_cmd -k "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-clone -k without gh prints manual instructions" "exit 0" "$status | $output"
            return
        fi

        if [[ "$output" != *"add manually"* ]]; then
            fail "sv-clone -k without gh prints manual instructions" "*add manually*" "$output"
            return
        fi

        origin_after=$(git -C "$clone_path" config remote.origin.url 2>/dev/null || true)
        if [[ "$origin_after" != "$expected_origin" ]]; then
            fail "sv-clone -k without gh leaves origin untouched" "$expected_origin" "$origin_after"
            return
        fi

        pass "sv-clone -k without gh prints manual instructions and leaves origin untouched"
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
    }
    queue_test test_sv_clone_dash_k_no_gh
    wait_for_all_running_tests

    # Remove the fixture workspace while the guard session is still up, so the
    # sandbox-side removal can run.  Also registered on EXIT in case we never
    # get here.
    cleanup_clone_workspace

    fi # end sv-clone tests (non-SSH only)

    ###############################################################################
    # Shell Args Tests
    ###############################################################################

    queue_test assert_sandbox_fails "cannot run invalid command" "definitely-not-a-command-xyz"
    queue_test assert_sandbox_args_contains "sv s -- printf preserves quoted args" "printf" "%s\\n" "a b" "c d" $'a b\nc d'
    queue_test assert_sandbox_exit_code "sv s -- exit 33 returns 33" 33 exit 33
    test_stdin_piping() {
        local output
        set +e
        output=$(echo "ABC" | sv_cmd s -- tr 'A-Z' 'a-z' 2>&1)
        set -e
        if [[ "$output" =~ ^abc ]]; then
            pass "sv s -- stdin piping works correctly"
        else
            fail "sv s -- stdin piping works correctly" "abc" "$output"
        fi
    }
    queue_test test_stdin_piping

    ###############################################################################
    # Agent Args Tests
    ###############################################################################

    # Agent and shell commands share quote_zsh_args (sv's ZSH_COMMAND), so a
    # plain printf exercises the same unicode/spaced-arg quoting without
    # stubbing an agent binary into the user's shared config directory.
    test_unicode_args() {
        local output
        local prompt="Reply with exactly 🍺 and no quotation marks."
        local status

        set +e
        output=$(/usr/bin/script -q /dev/null "${SV_CMD[@]}" --no-build s -- /usr/bin/printf 'unicode-arg:<%s>\n' "🍺" "$prompt" 2>&1)
        status=$?
        set -e

        if [[ "$status" -eq 0 && "$output" == *"unicode-arg:<🍺>"* && "$output" == *"unicode-arg:<$prompt>"* ]]; then
            pass "sv s -- preserves unicode args"
        else
            fail "sv s -- preserves unicode args" "unicode-arg:<🍺> and unicode-arg:<$prompt>" "$status | $output"
        fi
    }
    queue_test test_unicode_args

    ###############################################################################
    # Agentsview Export Tests
    ###############################################################################

    AGENTSVIEW_CONFIG_SCRIPT="$SCRIPT_DIR/../helpers/agentsview-config.py"
    AGENTSVIEW_PATHS_SCRIPT="$SCRIPT_DIR/../helpers/agentsview-paths.sh"

    # Path map sanity: every agent has all four associated keys defined.
    test_agentsview_path_map_complete() {
        # shellcheck source=../helpers/agentsview-paths.sh
        source "$AGENTSVIEW_PATHS_SCRIPT"
        local agent missing=""
        for agent in "${AGENTSVIEW_AGENTS[@]}"; do
            for field in SUBDIR DEFAULT TOMLKEY; do
                # shellcheck disable=SC2310 # a lookup failure is reported as a missing field
                if [[ -z "$(agentsview_field "$field" "$agent")" ]]; then
                    missing="$missing $agent.$field"
                fi
            done
        done
        if [[ -z "$missing" ]]; then
            pass "agentsview path map has all fields for all agents"
        else
            fail "agentsview path map has all fields for all agents" "no missing" "missing:$missing"
        fi
    }
    queue_test test_agentsview_path_map_complete

    # The Python writer has its own --self-test covering the load/merge/write
    # logic against a tmp dir. Run it here as part of the suite.
    test_agentsview_config_writer_self_test() {
        local output status
        set +e
        output=$(/usr/bin/python3 "$AGENTSVIEW_CONFIG_SCRIPT" --self-test \
            --config-path /tmp/agentsview-self-test --home /tmp/agentsview-home 2>&1)
        status=$?
        set -e
        if [[ "$status" -eq 0 ]]; then
            pass "agentsview-config.py --self-test passes"
        else
            fail "agentsview-config.py --self-test passes" "exit 0" "exit $status: $output"
        fi
    }
    queue_test test_agentsview_config_writer_self_test

    # End-to-end: --write produces a file that re-parses cleanly with the same
    # tool (round-trip stability), and a second --diff is empty. The --agent
    # list is built from AGENTSVIEW_AGENTS rather than hardcoded, so every
    # agent -- present and future -- exercises the Python side. That matters
    # because a key in VALID_KEYS but missing from DEFAULT_SUBPATHS passes
    # validation and then raises KeyError inside default_host_path on the write
    # path: a crash mid-`sv-agentsview-setup`, not a clean error.
    test_agentsview_config_writer_round_trip() {
        local paths="$SCRIPT_DIR/../helpers/agentsview-paths.sh"
        if [[ ! -r "$paths" ]]; then
            fail "agentsview config writer round-trip" "readable agentsview-paths.sh" "$paths"
            return
        fi
        # shellcheck source=/dev/null
        source "$paths"
        local tmpdir cfg home output status agent tomlkey
        tmpdir=$(mktemp -d)
        cfg="$tmpdir/config.toml"
        home="$tmpdir/home"
        mkdir -p "$home"
        local agent_args=()
        for agent in "${AGENTSVIEW_AGENTS[@]}"; do
            tomlkey="$(agentsview_field TOMLKEY "$agent")"
            agent_args+=(--agent "$tomlkey=$tmpdir/sessions/$agent")
        done
        set +e
        /usr/bin/python3 "$AGENTSVIEW_CONFIG_SCRIPT" \
            --config-path "$cfg" --home "$home" --write \
            "${agent_args[@]}" \
            > /dev/null 2>&1
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            rm -rf "$tmpdir"
            fail "agentsview config writer round-trip" "exit 0 on first write" "exit $status"
            return
        fi
        # Second invocation should produce empty diff (idempotent)
        set +e
        output=$(/usr/bin/python3 "$AGENTSVIEW_CONFIG_SCRIPT" \
            --config-path "$cfg" --home "$home" --diff \
            "${agent_args[@]}" 2>&1)
        status=$?
        set -e
        rm -rf "$tmpdir"
        if [[ "$status" -eq 0 && -z "$output" ]]; then
            pass "agentsview config writer round-trip is idempotent"
        else
            fail "agentsview config writer round-trip is idempotent" \
                "empty diff" "exit $status, output: $output"
        fi
    }
    queue_test test_agentsview_config_writer_round_trip

    # The setup-merge generator interpolates SUBDIR values into a quoted list
    # for the sandbox-side ACL loop. Two silent failure modes: a quoting break
    # makes the generated script a syntax error, and guest/home/configure runs
    # it under `set -Eeuo pipefail`, so sandbox startup aborts entirely; and an
    # agent with an empty SUBDIR yields a `""` element whose loop body resolves
    # to "$HOME/" and applies an inheriting group-read ACL to the whole sandbox
    # home, every session. Assert the real SUBDIR values assemble into a list
    # that parses, and that both guards against the empty case are in place.
    test_agentsview_setup_merge_generation_is_safe() {
        local paths="$SCRIPT_DIR/../helpers/agentsview-paths.sh"
        local setup="$SCRIPT_DIR/../sv-agentsview-setup"
        if [[ ! -r "$paths" || ! -r "$setup" ]]; then
            fail "agentsview setup-merge generation is safe" "readable sources" "$paths $setup"
            return
        fi
        # shellcheck source=/dev/null
        source "$paths"
        local agent _q _subdir subdir_list="" empty_found=false
        for agent in "${AGENTSVIEW_AGENTS[@]}"; do
            _subdir="$(agentsview_field SUBDIR "$agent")"
            [[ -n "$_subdir" ]] || empty_found=true
            printf -v _q '"%s" ' "$_subdir"
            subdir_list+="$_q"
        done
        # The assembled loop must parse as bash with the real values in it.
        local probe parses=false
        probe=$(mktemp)
        printf 'for subdir in %s; do :; done\n' "$subdir_list" > "$probe"
        bash -n "$probe" 2>/dev/null && parses=true
        rm -f "$probe"
        # Generator aborts on an empty SUBDIR; generated script skips one.
        local gen_guard=false run_guard=false
        grep -F -- 'has no SUBDIR"' "$setup" &>/dev/null && gen_guard=true
        # shellcheck disable=SC2016 # literal match: the file under test contains this text verbatim
        grep -F -- '[[ -n "\$subdir" ]] || continue' "$setup" &>/dev/null && run_guard=true
        if [[ "$empty_found" == "false" && "$parses" == "true" \
            && "$gen_guard" == "true" && "$run_guard" == "true" ]]; then
            pass "agentsview setup-merge generation is safe"
        else
            fail "agentsview setup-merge generation is safe" \
                "no empty SUBDIR, list parses, generator aborts and generated script skips on empty" \
                "empty=$empty_found parses=$parses gen_guard=$gen_guard run_guard=$run_guard"
        fi
    }
    queue_test test_agentsview_setup_merge_generation_is_safe

    # pi keeps auth.json in ~/.pi/agent, a parent of its session dir. mkdir -p
    # would create that parent at 0755 under the default umask, and pi's
    # auth-storage only applies 0700 at creation time -- it never chmods a
    # directory that already exists, so sandvault pre-creating it leaves the
    # credential directory group-listable for the life of the sandbox home. The
    # generated script must tighten it to 0700 with a traverse-only ACE, and
    # must do so *before* the session-dir loop, since mkdir -p on the session
    # dir would otherwise create the parent first at the default umask.
    test_agentsview_private_parent_tightened_first() {
        local paths="$SCRIPT_DIR/../helpers/agentsview-paths.sh"
        local setup="$SCRIPT_DIR/../sv-agentsview-setup"
        if [[ ! -r "$paths" || ! -r "$setup" ]]; then
            fail "agentsview private parent tightened first" "readable sources" "$paths $setup"
            return
        fi
        # shellcheck source=/dev/null
        source "$paths"
        local pi_private subdir
        # shellcheck disable=SC2310 # an empty result is reported by the check below
        pi_private="$(agentsview_field PRIVATE pi || true)"
        # shellcheck disable=SC2310 # an empty result is reported by the check below
        subdir="$(agentsview_field SUBDIR pi || true)"
        # The declared private dir must actually be a parent of the session dir,
        # or tightening it protects nothing.
        if [[ -z "$pi_private" || "$subdir" != "$pi_private/"* ]]; then
            fail "agentsview private parent tightened first" \
                "AGENTSVIEW_PRIVATE_pi set and a parent of SUBDIR" \
                "private=$pi_private subdir=$subdir"
            return
        fi
        local priv_line subdir_line
        # shellcheck disable=SC2016 # literal match: the file under test contains this text verbatim
        priv_line=$(grep -n 'for private in \$private_list' "$setup" | head -1 | cut -d: -f1 || true)
        # shellcheck disable=SC2016 # literal match: the file under test contains this text verbatim
        subdir_line=$(grep -n 'for subdir in \$subdir_list' "$setup" | head -1 | cut -d: -f1 || true)
        if [[ -z "$priv_line" || -z "$subdir_line" ]]; then
            fail "agentsview private parent tightened first" \
                "both generated loops present" \
                "private=$priv_line subdir=$subdir_line"
            return
        fi
        # shellcheck disable=SC2016 # literal match: the file under test contains this text verbatim
        if [[ "$priv_line" -lt "$subdir_line" ]] \
            && grep -F -- 'chmod 700 "\$priv_full"' "$setup" &>/dev/null \
            && grep -F -- 'SEARCH_ONLY_RIGHTS="group:$SANDVAULT_GROUP allow search,readattr"' "$setup" &>/dev/null; then
            pass "agentsview private parent tightened first"
        else
            fail "agentsview private parent tightened first" \
                "private loop before subdir loop, chmod 700 + traverse-only ACE" \
                "private=$priv_line subdir=$subdir_line"
        fi
    }
    queue_test test_agentsview_private_parent_tightened_first

    # AGENTSVIEW_DEFAULT_* (shell) and DEFAULT_SUBPATHS (Python) hold the same
    # host-side defaults, but only the Python table is consumed when writing
    # config.toml. They can drift for pi or any future agent with nothing
    # catching it, so assert they agree.
    test_agentsview_default_tables_agree() {
        local paths="$SCRIPT_DIR/../helpers/agentsview-paths.sh"
        if [[ ! -r "$paths" ]]; then
            fail "agentsview default tables agree" "readable agentsview-paths.sh" "$paths"
            return
        fi
        # shellcheck source=/dev/null
        source "$paths"
        local agent tomlkey shell_default py_default mismatches=""
        for agent in "${AGENTSVIEW_AGENTS[@]}"; do
            # shellcheck disable=SC2310 # an empty result surfaces as a reported mismatch
            tomlkey="$(agentsview_field TOMLKEY "$agent" || true)"
            # shellcheck disable=SC2310 # an empty result surfaces as a reported mismatch
            shell_default="$(agentsview_field DEFAULT "$agent" || true)"
            # `|| true`: a python failure here must surface as a mismatch the
            # test reports, not a pipefail abort of the whole suite.
            py_default=$(/usr/bin/python3 -c '
import runpy, sys
mod = runpy.run_path(sys.argv[1])
print(mod["DEFAULT_SUBPATHS"].get(sys.argv[2], "<missing>"))
' "$AGENTSVIEW_CONFIG_SCRIPT" "$tomlkey" 2>/dev/null || true)
            if [[ "$shell_default" != "$py_default" ]]; then
                mismatches+="$agent($tomlkey): shell=$shell_default py=$py_default "
            fi
        done
        if [[ -z "$mismatches" ]]; then
            pass "agentsview default tables agree"
        else
            fail "agentsview default tables agree" \
                "AGENTSVIEW_DEFAULT_* == DEFAULT_SUBPATHS for every agent" \
                "$mismatches"
        fi
    }
    queue_test test_agentsview_default_tables_agree

    # The config writer's --check mode compares parsed values, not rendered
    # text, so a hand-edited config.toml (comments, formatting drift) doesn't
    # produce a perpetual non-empty diff that would re-prompt on every run.
    # Exit 0 = clean, 1 = a mirror path is missing, 3 = config error (e.g. a
    # scalar where an array belongs, which list() would char-split).
    test_agentsview_config_check_mode() {
        local tmpdir cfg home st out
        tmpdir=$(mktemp -d)
        cfg="$tmpdir/config.toml"
        home="$tmpdir/home"
        mkdir -p "$home/.claude/projects"
        local mirror="$tmpdir/sessions/claude"
        local default="$home/.claude/projects"
        local results=""

        # clean: mirror already present -> 0
        printf 'claude_project_dirs = ["%s", "%s"]\n' "$default" "$mirror" > "$cfg"
        set +e; /usr/bin/python3 "$AGENTSVIEW_CONFIG_SCRIPT" \
            --config-path "$cfg" --home "$home" --check \
            --agent claude_project_dirs="$mirror" >/dev/null 2>&1; st=$?; set -e
        [[ "$st" -eq 0 ]] || results+="clean:$st "

        # pending: mirror missing -> 1
        printf 'claude_project_dirs = ["%s"]\n' "$default" > "$cfg"
        set +e; /usr/bin/python3 "$AGENTSVIEW_CONFIG_SCRIPT" \
            --config-path "$cfg" --home "$home" --check \
            --agent claude_project_dirs="$mirror" >/dev/null 2>&1; st=$?; set -e
        [[ "$st" -eq 1 ]] || results+="pending:$st "

        # error: scalar value -> 3 (not char-split on write)
        printf 'claude_project_dirs = "/some/scalar/path"\n' > "$cfg"
        set +e; out=$(/usr/bin/python3 "$AGENTSVIEW_CONFIG_SCRIPT" \
            --config-path "$cfg" --home "$home" --check \
            --agent claude_project_dirs="$mirror" 2>&1); st=$?; set -e
        [[ "$st" -eq 3 ]] || results+="scalar:$st "
        # Clean error message, not a silent char-split.
        [[ "$out" == *"must be an array of paths"* ]] || results+="scalar-msg "
        # And the scalar file must be left untouched (no char-split rewrite).
        grep -q '^claude_project_dirs = "/some/scalar/path"$' "$cfg" \
            || results+="scalar-rewritten "

        # error: malformed TOML -> 3, not 1 (so a non-interactive run never
        # mistakes a parse failure for a pending change and swallows it).
        printf 'bad = = = invalid toml\n' > "$cfg"
        set +e; /usr/bin/python3 "$AGENTSVIEW_CONFIG_SCRIPT" \
            --config-path "$cfg" --home "$home" --check \
            --agent claude_project_dirs="$mirror" >/dev/null 2>&1; st=$?; set -e
        [[ "$st" -eq 3 ]] || results+="malformed:$st "

        rm -rf "$tmpdir"
        if [[ -z "$results" ]]; then
            pass "agentsview-config.py --check exits 0/1/3 correctly"
        else
            fail "agentsview-config.py --check exits 0/1/3 correctly" \
                "clean=0 pending=1 scalar=3 malformed=3 untouched" "$results"
        fi
    }
    queue_test test_agentsview_config_check_mode

    # Structural: sv-agentsview-setup re-syncs on every run (not prompt-once),
    # and the per-key decline list is the permanent-skip mechanism. Assert the
    # new wiring is present and the old prompt-once flow is gone, the way the
    # other setup-merge structural tests do.
    test_agentsview_resync_wiring() {
        local setup="$SCRIPT_DIR/../sv-agentsview-setup"
        if [[ ! -r "$setup" ]]; then
            fail "agentsview resync wiring" "readable sv-agentsview-setup" "$setup"
            return
        fi
        local missing=""
        grep -Fq -- 'agentsview_resync_config()' "$setup" || missing+="resync-fn "
        grep -Fq -- 'agentsview_first_run_prompt()' "$setup" || missing+="first-run-fn "
        grep -Fq -- 'agentsview_record_decline()' "$setup" || missing+="record-decline-fn "
        grep -Fq -- 'AGENTSVIEW_DECLINED_FILE' "$setup" || missing+="declined-var "
        grep -Fq -- '--check' "$setup" || missing+="check-arg "
        # old prompt-once flow must be gone
        if grep -Fq -- 'agentsview_update_config()' "$setup"; then
            missing+="old-update-fn-present "
        fi
        # re-sync must run when enabled (not only at opt-in)
        grep -Fq -- 'agentsview_install_symlinks' "$setup" || missing+="install-symlinks "
        if [[ -z "$missing" ]]; then
            pass "agentsview resync wiring present, prompt-once gone"
        else
            fail "agentsview resync wiring present, prompt-once gone" \
                "resync fn + first-run + decline + --check, no old update" \
                "$missing"
        fi
    }
    queue_test test_agentsview_resync_wiring

    # The standalone integration test sources the real sv-agentsview-setup
    # functions and drives the real python writer through the re-sync +
    # decline flow end to end (no-op, check->write->check idempotence, decline
    # de-dup + skip, scalar clean error, partial-decline filter). It isolates
    # itself with a throwaway USER/HOME under /Users/Shared and cleans up, so it
    # is safe to run from inside the suite. Wire it in so the real resync path
    # is covered in CI, not just the structural greps above.
    test_agentsview_resync_integration() {
        local t="$SCRIPT_DIR/test-agentsview-resync.sh"
        if [[ ! -x "$t" ]]; then
            fail "agentsview resync integration" "executable $t" "$t"
            return
        fi
        local out status
        set +e
        out=$("$t" 2>&1)
        status=$?
        set -e
        if [[ "$status" -eq 0 ]]; then
            pass "agentsview resync integration"
        else
            fail "agentsview resync integration" "exit 0" "exit $status: $out"
        fi
    }
    queue_test test_agentsview_resync_integration

    ###############################################################################
    # iOS Simulator Device Picker Tests
    ###############################################################################

    IOS_PICK_DEVICE_SCRIPT="$SCRIPT_DIR/../helpers/sv-ios-pick-device"

    # A partially installed newest runtime can list none of the newest
    # iPhones; simctl create then fails with "Incompatible device" (#313).
    # The picker must pair each runtime only with device types it supports,
    # falling back to an older runtime when the newest supports no iPhone.
    test_ios_pick_device_respects_supported_types() {
        local devtypes runtimes out1 out2 out3
        devtypes='"devicetypes": [
            {"identifier": "dt.iPhone-18", "name": "iPhone 18", "productFamily": "iPhone"},
            {"identifier": "dt.iPhone-17", "name": "iPhone 17", "productFamily": "iPhone"},
            {"identifier": "dt.iPad", "name": "iPad Pro", "productFamily": "iPad"}]'
        # Newest runtime supports only an older iPhone: pick that pair.
        runtimes='"runtimes": [
            {"identifier": "rt.27-1", "name": "iOS 27.1", "version": "27.1", "isAvailable": true,
             "supportedDeviceTypes": [{"identifier": "dt.iPhone-17"}]},
            {"identifier": "rt.27-0", "name": "iOS 27.0", "version": "27.0", "isAvailable": true,
             "supportedDeviceTypes": [{"identifier": "dt.iPhone-18"}]}]'
        out1=$(echo "{$devtypes, $runtimes}" | "$IOS_PICK_DEVICE_SCRIPT")
        # Newest runtime supports no iPhone: fall back to the older runtime.
        runtimes='"runtimes": [
            {"identifier": "rt.27-1", "name": "iOS 27.1", "version": "27.1", "isAvailable": true,
             "supportedDeviceTypes": [{"identifier": "dt.iPad"}]},
            {"identifier": "rt.27-0", "name": "iOS 27.0", "version": "27.0", "isAvailable": true,
             "supportedDeviceTypes": [{"identifier": "dt.iPhone-18"}]}]'
        out2=$(echo "{$devtypes, $runtimes}" | "$IOS_PICK_DEVICE_SCRIPT")
        # No supportedDeviceTypes key (older simctl): newest of each.
        runtimes='"runtimes": [
            {"identifier": "rt.27-1", "name": "iOS 27.1", "version": "27.1", "isAvailable": true}]'
        out3=$(echo "{$devtypes, $runtimes}" | "$IOS_PICK_DEVICE_SCRIPT")

        local expected=$'dt.iPhone-17\trt.27-1|dt.iPhone-18\trt.27-0|dt.iPhone-18\trt.27-1'
        local got="$out1|$out2|$out3"
        if [[ "$got" == "$expected" ]]; then
            pass "sv-ios-pick-device pairs runtimes only with supported device types"
        else
            fail "sv-ios-pick-device pairs runtimes only with supported device types" "$expected" "$got"
        fi
    }
    queue_test test_ios_pick_device_respects_supported_types

    ###############################################################################
    # Summary
    ###############################################################################

    collect_results

    if [[ "$VERBOSE" -ne 0 ]]; then
        echo -e "Passed: ${GREEN}$TESTS_PASSED${NC}"
        echo -e "Failed: ${RED}$TESTS_FAILED${NC}"
    fi

    if [[ "$TESTS_FAILED" -gt 0 ]]; then
        exit 1
    fi

}


