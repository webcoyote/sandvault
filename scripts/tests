    ###############################################################################

    # sandbox-exec should block /Volumes access (except Macintosh HD)
    queue_test assert_sandbox_fails "cannot ls /Volumes" "ls /Volumes"
    queue_test assert_sandbox_fails "cannot read /Volumes" "cat /Volumes/test 2>&1"

    ###############################################################################
    # Sandbox Escape Tests: Sensitive System Files
    ###############################################################################

    # Should not be able to read shadow password file or other sensitive files
    queue_test assert_sandbox_fails "cannot read /etc/sudoers" "cat /etc/sudoers"
    queue_test assert_sandbox_fails "cannot read /etc/master.passwd" "cat /etc/master.passwd"

    ###############################################################################
    # Sandbox Allowed Access Tests
    ###############################################################################

    # Should be able to access shared workspace
    queue_test assert_sandbox_pipe_contains "can access shared workspace" "ls $SHARED_WORKSPACE" "SANDVAULT-README"
    queue_test assert_sandbox_exit_code "sv s -- touch SANDVAULT-README.md" 0 touch -c "$SHARED_WORKSPACE/SANDVAULT-README.md"

    # SANDVAULT-README.md lives in $SHARED_WORKSPACE, which the sandbox user can
    # write, so anything at that path may be a symlink the sandbox planted. A
    # plain ">" redirect follows it and truncates the target as the host user,
    # and "mv" moves *into* a linked directory. These tests run the script's own
    # write function against a scratch workspace and check that the host never
    # writes through a link.
    #
    # Usage: run_readme_write WORKDIR [PLANT_CMD]
    # PLANT_CMD runs inside the render step, i.e. after the "already exists"
    # check and before the rename, which is the window a racing sandbox gets.
    run_readme_write() {
        local workdir="$1" plant="${2:-}" run render write
        render=$(sed -n '/^render_shared_workspace_readme() {$/,/^}$/p' "$SV_BASE")
        write=$(sed -n '/^write_shared_workspace_readme() {$/,/^}$/p' "$SV_BASE")
        [[ -n "$render" && -n "$write" ]] || { echo "functions not found in sv"; return 1; }
        run="$workdir/../run-readme-write"
        {
            echo '#!/bin/bash'
            echo 'set -Eeuo pipefail'
            echo 'trace() { :; }'
            printf '%s\n' "$render"
            if [[ -n "$plant" ]]; then
                # Rename the real renderer and wrap it so the link appears mid-write.
                # shellcheck disable=SC2016 # emitted code, expanded by the generated script
                echo 'eval "real_$(declare -f render_shared_workspace_readme)"'
                printf 'render_shared_workspace_readme() { %s; real_render_shared_workspace_readme; }\n' "$plant"
            fi
            printf '%s\n' "$write"
            echo 'write_shared_workspace_readme'
        } > "$run"
        WORKSPACE="$SCRIPT_DIR/.." HOST_USER=testuser SV_PROFILE='' \
            SANDVAULT_USER=sandvault-testuser SHARED_WORKSPACE="$workdir" \
            SANDVAULT_FILE_RIGHTS="user:$(id -un) allow read" \
            "$SYSTEM_BASH" "$run" 2>&1
    }

    # Readme scratch layout: $base/ws is the workspace, $base holds the host
    # files the sandbox would aim at (outside the workspace, as in real life).
    new_readme_scratch() {
        local base
        base="$(mktemp -d)"
        mkdir "$base/ws" "$base/host-dir"
        printf 'HOST PRIVATE DATA\n' > "$base/host-private"
        /bin/chmod 0600 "$base/host-private"
        echo "$base"
    }

    # First run: the README must be created as a regular file.
    test_workspace_readme_created_when_missing() {
        local name="workspace README created when missing" base dest out
        base="$(new_readme_scratch)"; dest="$base/ws/SANDVAULT-README.md"
        # shellcheck disable=SC2310 # the write's failure is what the test checks
        if ! out=$(run_readme_write "$base/ws"); then
            fail "$name" "write succeeds" "$out"
        elif [[ -L "$dest" || ! -f "$dest" ]]; then
            fail "$name" "regular file at the README path" "missing or a link"
        else
            pass "$name"
        fi
        rm -rf "$base"
    }
    queue_test test_workspace_readme_created_when_missing

    # An existing README is left alone: the host does not read or rewrite it.
    test_workspace_readme_existing_left_alone() {
        local name="workspace README left alone when present" base dest out
        base="$(new_readme_scratch)"; dest="$base/ws/SANDVAULT-README.md"
        printf 'user edited\n' > "$dest"
        # shellcheck disable=SC2310 # the write's failure is what the test checks
        if ! out=$(run_readme_write "$base/ws"); then
            fail "$name" "write succeeds" "$out"
        elif [[ "$(cat "$dest")" != 'user edited' ]]; then
            fail "$name" "existing README unchanged" "README was rewritten"
        else
            pass "$name"
        fi
        rm -rf "$base"
    }
    queue_test test_workspace_readme_existing_left_alone

    # The sandbox can plant a link after the existence check. The rename must
    # replace it rather than write through it.
    test_workspace_readme_racing_file_symlink() {
        local name="workspace README racing file symlink replaced" base dest out
        base="$(new_readme_scratch)"; dest="$base/ws/SANDVAULT-README.md"
        # shellcheck disable=SC2310 # the write's failure is what the test checks
        if ! out=$(run_readme_write "$base/ws" "ln -s '$base/host-private' '$dest'"); then
            fail "$name" "write succeeds" "$out"
        elif [[ "$(cat "$base/host-private")" != 'HOST PRIVATE DATA' ]]; then
            fail "$name" "symlink target untouched" "target was overwritten by the host"
        elif [[ -L "$dest" || ! -f "$dest" ]]; then
            fail "$name" "link replaced by the README" "destination is still a link or missing"
        else
            pass "$name"
        fi
        rm -rf "$base"
    }
    queue_test test_workspace_readme_racing_file_symlink

    # Same race with a link to a *directory*: plain "mv" would move the README
    # into the host directory and leave the link in place.
    test_workspace_readme_racing_directory_symlink() {
        local name="workspace README racing directory symlink replaced" base dest out
        base="$(new_readme_scratch)"; dest="$base/ws/SANDVAULT-README.md"
        # shellcheck disable=SC2310 # the write's failure is what the test checks
        if ! out=$(run_readme_write "$base/ws" "ln -s '$base/host-dir' '$dest'"); then
            fail "$name" "write succeeds" "$out"
        elif [[ -n "$(/bin/ls -A "$base/host-dir")" ]]; then
            fail "$name" "nothing written inside the linked host directory" "host directory gained: $(/bin/ls -A "$base/host-dir")"
        elif [[ -L "$dest" || ! -f "$dest" ]]; then
            fail "$name" "link replaced by the README" "destination is still a link or missing"
        else
            pass "$name"
        fi
        rm -rf "$base"
    }
    queue_test test_workspace_readme_racing_directory_symlink

    # The bridge runs as the host user and writes screenshots into a scratch
    # dir under $SHARED_WORKSPACE/_sandvault, which the sandbox user can write.
    # The sandbox can rename that dir and plant a symlink at its path, which
    # would make a host process write wherever the link points. Screenshots
    # must still land in the real scratch dir (readable by the sandbox), and
    # nothing may be written through the planted link.
    test_ios_bridge_screenshot_publish() {
        local workdir output status
        workdir="$(mktemp -d)"

        set +e
        output=$(/usr/bin/python3 - "$SCRIPT_DIR/../helpers/sv-ios-bridge" "$workdir" <<'PY' 2>&1
import importlib.util, os, sys
from importlib.machinery import SourceFileLoader

bridge_path, root = sys.argv[1], sys.argv[2]
sys.dont_write_bytecode = True
loader = SourceFileLoader("sv_ios_bridge", bridge_path)
spec = importlib.util.spec_from_loader("sv_ios_bridge", loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)

for name in ("open_scratch_dir", "screenshot_name", "publish_screenshot"):
    if not hasattr(mod, name):
        sys.exit(f"{name} missing from the bridge")

scratch = os.path.join(root, "scratch")
private = os.path.join(root, "private")
decoy = os.path.join(root, "decoy")
for d in (scratch, private, decoy):
    os.mkdir(d)

mod.SCRATCH_DIR = scratch
mod.SCRATCH_DIR_FD = mod.open_scratch_dir(scratch)
mod.PRIVATE_DIR = private

# The guest moves the real scratch dir aside and links its path to a decoy.
moved = os.path.join(root, "scratch-moved")
os.rename(scratch, moved)
os.symlink(decoy, scratch)

name = mod.screenshot_name("screenshot-pixels", "png")
src = os.path.join(private, name)
with open(src, "wb") as f:
    f.write(b"\x89PNG")
os.chmod(src, 0o600)
mod.publish_screenshot(src, name)

if os.listdir(decoy):
    sys.exit(f"screenshot followed the planted symlink: {os.listdir(decoy)}")
landed = os.path.join(moved, name)
if not os.path.isfile(landed):
    sys.exit("screenshot did not land in the real scratch dir")
mode = os.stat(landed).st_mode & 0o777
if mode != 0o644:
    sys.exit(f"screenshot mode is {oct(mode)}, want 0o644 so the sandbox can read it")
if os.path.exists(src):
    sys.exit("screenshot was left behind in the private dir")
print("ok")
PY
)
        status=$?
        set -e

        if [[ "$status" -ne 0 ]]; then
            fail "iOS bridge publishes screenshots without following planted symlinks" "ok" "$output"
        else
            pass "iOS bridge publishes screenshots without following planted symlinks"
        fi
        rm -rf "$workdir"
    }
    queue_test test_ios_bridge_screenshot_publish

    # Should be able to access home directory
    queue_test assert_sandbox_exit_code "sv s -- touch $SANDVAULT_HOME/README.md" 0 touch -c "$SANDVAULT_HOME/README.md"

    # Should be able to run basic commands
    queue_test assert_sandbox_pipe_contains "can run echo" "echo hello" "hello"

    test_pwd() {
        pushd /Users &>/dev/null
        assert_sandbox_pipe_contains "can run pwd" "pwd" "$PWD"
        popd &>/dev/null
    }
    queue_test test_pwd

    ###############################################################################
    # Initial Directory Tests
    ###############################################################################

    # Test that unreadable directory falls back to SHARED_WORKSPACE
    # Host user's home directory should not be readable by sandvault user
    test_unreadable_dir_fallback() {
        local output
        output=$(cd "$HOST_HOME" && echo "pwd ; exit" | sv_cmd s 2>&1)
        if [[ "$output" == *"$SHARED_WORKSPACE"* ]]; then
            pass "unreadable directory falls back to SHARED_WORKSPACE"
        else
            fail "unreadable directory falls back to SHARED_WORKSPACE" "$SHARED_WORKSPACE" "$output"
        fi
    }

    # This test does not work when running inside sandvault
    # because it's not possible to change directory into an
    # unreadable directory to cause the failure.
    if [[ -z "${SV_SESSION_ID:-}" ]]; then
        queue_test test_unreadable_dir_fallback
    fi

    # Test that readable directory is used as working directory
    # /Users is readable by all users
    test_readable_dir_used() {
        local output
        output=$(cd /Users && echo "pwd ; exit" | sv_cmd s 2>&1)
        if [[ "$output" == *"/Users"* ]]; then
            pass "readable directory is used as working directory"
        else
            fail "readable directory is used as working directory" "/Users" "$output"
        fi
    }
    queue_test test_readable_dir_used

    # Test that --clone aborts with a message directing users to sv-clone.
    test_clone_flag_rejected() {
        local output
        local status

        set +e
        output=$(sv_cmd s --clone https://example.com/repo.git 2>&1)
        status=$?
        set -e

        if [[ "$status" -ne 0 && "$output" == *"sv-clone"* ]]; then
            pass "--clone aborts with sv-clone migration message"
        else
            fail "--clone aborts with sv-clone migration message" "non-zero exit mentioning sv-clone" "$status | $output"
        fi
    }
    queue_test test_clone_flag_rejected

    ###############################################################################
    # sv-clone Tests
    #
    # sv-clone runs as the host user (not inside the sandbox), so these tests
    # call the script directly rather than going through sv_cmd.  They are
    # gated on mode_label to run only once (default mode, not SSH).
    ###############################################################################
    SV_CLONE_BASE="$SCRIPT_DIR/../sv-clone"

    if [[ "$mode_label" != *" --ssh" && -x "$SV_CLONE_BASE" ]]; then

    # sv-clone writes to $SHARED_WORKSPACE/repos/<name>, which for this repo is
    # exactly where sv-clone puts a contributor's own checkout (see README).
    # Cloning and rm -rf'ing that path would destroy uncommitted work, so point
    # sv-clone at a unique per-run workspace instead: the fixture path can then
    # never collide with a real checkout, whatever the repo is named.
    #
    # Deliberately not under $SHARED_WORKSPACE/repos -- that directory holds the
    # user's real checkouts, and a fixture leaked there (or a stray rm) lands
    # right next to them.  _tests/ is ours alone, so a leak is harmless.
    mkdir -p "$SHARED_WORKSPACE/_tests"
    CLONE_WORKSPACE="$(mktemp -d "$SHARED_WORKSPACE/_tests/clone.XXXXXX")"
    mkdir -p "$CLONE_WORKSPACE/repos" "$CLONE_WORKSPACE/_sandvault/.ssh"

    sv_clone_cmd() {
        SV_CLONE_WORKSPACE_ROOT="$CLONE_WORKSPACE" "$bash_path" "$SV_CLONE_BASE" "$@"
    }

    # Create a minimal throwaway git repo with a GitHub-shaped origin.
    # Usage: make_test_repo <variable_name> [owner/repo]
    # Writes the path into the named variable.  The repo lives under
    # $CLONE_WORKSPACE so cleanup_clone_workspace sweeps it automatically.
    # The repo gets one empty commit so git clone / bundle work.
    # Tests should use this instead of pointing sv-clone at the real
    # sandvault checkout, which must never have its config mutated.
    make_test_repo() {
        local _var="$1"
        local github_path="${2:-sv-test-org/test-repo}"
        local dir
        dir="$(mktemp -d "$CLONE_WORKSPACE/src.XXXXXX")"
        GIT_CONFIG_GLOBAL=/dev/null git -C "$dir" init -q
        GIT_CONFIG_GLOBAL=/dev/null git -C "$dir" -c user.email=t@t -c user.name=t \
            commit -q --allow-empty -m "init"
        git -C "$dir" remote add origin "git@github.com:${github_path}.git"
        eval "$_var=\$dir"
    }

    # Create a fake `gh` on PATH that records every invocation (to
    # GH_STUB_LOG) and tracks a minimal deploy-key registry (in
    # GH_STUB_STATE, set by the caller as env vars), so the -k/-w code paths
    # can be exercised without a real GitHub token or network access.
    make_gh_stub() {
        local stub_dir="$1"
        mkdir -p "$stub_dir"
        cat > "$stub_dir/gh" <<'STUB_EOF'
#!/bin/bash
echo "$@" >> "$GH_STUB_LOG"
case "$1" in
    auth)
        exit 0
        ;;
    repo)
        case "$2" in
            deploy-key)
                case "$3" in
                    list)
                        shift 3
                        jqexpr=""
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                --jq) jqexpr="$2"; shift 2 ;;
                                *) shift ;;
                            esac
                        done
                        # Emit real GitHub-shaped JSON (id/title/readOnly, the
                        # exact fields `gh --json` produces) from the state file
                        # and run the script's own --jq expression against it via
                        # the real jq. This exercises the field names the script
                        # actually references, so a regression like .read_only
                        # vs .readOnly is caught here instead of being masked by
                        # a stub that reconstructs the output itself.
                        json="$(awk -F'\t' 'BEGIN{printf "["; sep=""}
                            {printf "%s{\"id\":%s,\"title\":\"%s\",\"readOnly\":%s}", sep, $2, $1, $3; sep=","}
                            END{printf "]"}' "$GH_STUB_STATE" 2>/dev/null)"
                        [[ -z "$json" ]] && json="[]"
                        printf '%s' "$json" | jq -r "$jqexpr"
                        exit 0
                        ;;
                    add)
                        shift 3
                        # Keep the key body sv-clone handed us, so a test can
                        # assert what was uploaded, not just that an add happened.
                        [[ -f "$1" ]] && cp "$1" "$GH_STUB_STATE.received"
                        shift # public key path
                        title=""
                        write=false
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                --title) title="$2"; shift 2 ;;
                                --allow-write) write=true; shift ;;
                                -R) shift 2 ;;
                                *) shift ;;
                            esac
                        done
                        newid="$(date +%s%N)"
                        ro=true
                        $write && ro=false
                        grep -v -F "$(printf '%s\t' "$title")" "$GH_STUB_STATE" > "$GH_STUB_STATE.tmp" 2>/dev/null || true
                        mv "$GH_STUB_STATE.tmp" "$GH_STUB_STATE"
                        printf '%s\t%s\t%s\n' "$title" "$newid" "$ro" >> "$GH_STUB_STATE"
                        exit 0
                        ;;
                    delete)
                        id="$4"
                        awk -F'\t' -v i="$id" '$2!=i' "$GH_STUB_STATE" > "$GH_STUB_STATE.tmp" 2>/dev/null || true
                        mv "$GH_STUB_STATE.tmp" "$GH_STUB_STATE"
                        exit 0
                        ;;
                esac
                ;;
        esac
        ;;
esac
exit 1
STUB_EOF
        chmod +x "$stub_dir/gh"
    }

    # Test cloning a local repository via sv-clone and wiring remotes.
    # Uses a throwaway repo so the real checkout's config is never at risk.
    test_sv_clone_local() {
        local src_repository clone_path output status
        local host_origin remote_output
        local github_path="sv-test-org/clone-local"

        make_test_repo src_repository "$github_path"

        clone_path="$CLONE_WORKSPACE/repos/$(basename "$src_repository")"

        # Clean up any previous clone so the test is idempotent.
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1

        # sv-clone clones the repo then exec's sv with the repo path.
        # Pass "-- --no-build shell -- true" so the launched sv session
        # exits immediately without requiring an interactive shell.
        set +e
        output=$(sv_clone_cmd "$src_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-clone clones local repository" "exit 0" "$status | $output"
            return
        fi

        # Verify the clone was created.
        if [[ ! -d "$clone_path/.git" ]]; then
            fail "sv-clone clones local repository" "$clone_path/.git exists" "directory not found"
            return
        fi

        # Host origin should still point at the upstream remote.
        host_origin="$(git -C "$src_repository" remote get-url origin 2>/dev/null)"
        if [[ "$host_origin" != "git@github.com:${github_path}.git" ]]; then
            fail "local repository keeps origin at upstream" "git@github.com:${github_path}.git" "$host_origin"
            return
        fi

        # SV_CLONE_WORKSPACE_ROOT is set (via sv_clone_cmd), so sv-clone
        # should have skipped adding a 'sandvault' remote to the local repo.
        if git -C "$src_repository" remote get-url sandvault &>/dev/null; then
            fail "test-mode sv-clone does not add sandvault remote" "no remote" "remote exists"
            return
        fi

        # The clone's origin should point to the upstream repo.
        set +e
        remote_output=$(git -C "$clone_path" config remote.origin.url 2>&1)
        status=$?
        set -e
        local actual_repo_path
        actual_repo_path="$(github_repo_path "$remote_output")"
        if [[ "$status" -ne 0 || "$actual_repo_path" != "$github_path" ]]; then
            fail "sv-clone clone origin points to upstream" "$github_path" "$status | $remote_output"
            return
        fi

        pass "sv-clone clones local repository"

        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
    }
    queue_test test_sv_clone_local

    # Clone tests share the same destination repo name (`sandvault`) and race if parallelized.
    wait_for_all_running_tests

    # Test cloning an HTTPS repository via sv-clone.
    test_sv_clone_https() {
        local clone_path
        local output
        local status
        local remote_output
        local https_repository

        https_repository="https://github.com/webcoyote/sandvault.git"
        clone_path="$CLONE_WORKSPACE/repos/sandvault"

        # Start clean to avoid stale clone state influencing assertions.
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1

        set +e
        output=$(sv_clone_cmd "$https_repository" -- --no-build shell -- true 2>&1)
        status=$?
        set -e
        if [[ "$status" -ne 0 ]]; then
            fail "sv-clone clones HTTPS repository" "exit 0" "$status | $output"
            return
        fi

        if [[ ! -d "$clone_path/.git" ]]; then
            fail "sv-clone clones HTTPS repository" "$clone_path/.git exists" "directory not found"
            return
        fi

        # Use "git config remote.origin.url" instead of
        # "git remote get-url" to avoid issues with
        # git url remapping with insteadOf override.
        set +e
        remote_output=$(git -C "$clone_path" config remote.origin.url 2>&1)
        status=$?
        set -e
        # Deploy key setup may rewrite the URL to SSH, so compare repo path

        local actual_repo_path expected_repo_path
        actual_repo_path="$(github_repo_path "$remote_output")"
        expected_repo_path="$(github_repo_path "$https_repository")"
        if [[ "$status" -ne 0 || "$actual_repo_path" != "$expected_repo_path" ]]; then
            fail "sv-clone HTTPS clone origin points to remote URL" "$https_repository" "$status | $remote_output"
            return
        fi

        pass "sv-clone clones HTTPS repository"
        sv_cmd s -- rm -rf "$clone_path" >/dev/null 2>&1
    }
    queue_test test_sv_clone_https

    # Test that sv-clone rejects missing repository argument.
    test_sv_clone_rejects_missing_arg() {
