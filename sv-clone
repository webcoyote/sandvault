#!/bin/bash
# Clone a git repository into the sandvault shared workspace.
#
# This script runs as $USER (the host user), which has full permissions to
# read local repositories and clone from remote URLs. The clone destination
# is $SHARED_WORKSPACE/repos/<name>, which is accessible to both the host
# user and the sandvault user via group ACLs.
#
# After cloning, it launches an sv session in the cloned repository.
#
# Usage:
#   sv-clone [-v|-vv|-vvv] [options] <URL|PATH> [-- sv-args ...]
#
# Options:
#   -k, --repo-deploy-key    Create a deploy key for this repo and upload it
#                            to GitHub (read-only)
#   -w, --allow-repo-write   Allow the deploy key to push to this repo
#                            (implies --repo-deploy-key)
#
# Everything after -- is passed directly to sv (options, command, args).
# If no command is given, defaults to "shell".
#
# Examples:
#   sv-clone https://github.com/org/repo.git
#   sv-clone -k git@github.com:org/repo.git -- claude
#   sv-clone -w ~/projects/myrepo -- -b shell -- echo hello
set -Eeuo pipefail
trap 'echo >&2 "${BASH_SOURCE[0]}: line $LINENO: $BASH_COMMAND: exitcode $?"' ERR

# Resolve script location
# perform "readlink -f", which is not supported in macOS system bash
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd -P)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
WORKSPACE="$(cd -P "$(dirname "$SOURCE")" && pwd -P)"

# If running from a Homebrew Cellar (e.g. /opt/homebrew/Cellar/sandvault/1.2.3/libexec),
# use the stable opt/ symlink instead so generated scripts don't break on upgrade.
if [[ "$WORKSPACE" =~ ^(.*)/homebrew/Cellar/([^/]+)/[^/]+(/.+)?$ ]]; then
    WORKSPACE="${BASH_REMATCH[1]}/homebrew/opt/${BASH_REMATCH[2]}${BASH_REMATCH[3]}"
fi
readonly WORKSPACE

SV="$WORKSPACE/sv"
if [[ ! -x "$SV" ]]; then
    echo >&2 "ERROR: sv not found at $SV"
    exit 1
fi


###############################################################################
# Functions
###############################################################################
# shellcheck source=helpers/sv-logging.sh
source "$WORKSPACE/helpers/sv-logging.sh"

# Run git against the cloned repo, which lives under the shared workspace and
# is writable by the (untrusted) sandvault user via group ACLs. Git treats
# several config keys as commands to run (core.fsmonitor, core.sshCommand,
# core.pager, core.hooksPath, [filter] drivers, ...), so a guest that poisons
# $REPO_DIR/.git/config could execute code as the host user the next time we
# run git here. Override the dangerous keys to inert values on the command
# line; -c wins over the repo config. The repo is owned by the host user, so
# git's safe.directory check never fires and otherwise trusts the config.
# This only covers the config reads/writes below; those keys are not a
# complete list, so never use git_repo for fetch or other transport commands.
# git runs several config values as commands (core.fsmonitor, core.sshCommand,
# core.hooksPath, core.pager, core.alternateRefsCommand, [filter] drivers). Any
# directory the host runs git in may be writable by the sandbox user -- the
# clone, and any workspace path handed to sv-clone as its source -- so every
# host-side call goes through this, which neutralizes those keys on the command
# line (-c wins over repo config).
git_safe() {
    local dir="$1"
    shift
    git \
        -c core.fsmonitor= \
        -c core.sshCommand= \
        -c core.hooksPath=/dev/null \
        -c core.pager=cat \
        -c core.alternateRefsCommand= \
        -c protocol.ext.allow=never \
        -C "$dir" "$@"
}

git_repo() {
    git_safe "$REPO_DIR" "$@"
}


###############################################################################
# Parse command line
###############################################################################
CLONE_REPOSITORY=""
SV_ARGS=()
DEPLOY_KEY=false
DEPLOY_KEY_WRITE=false

if [[ $# -lt 1 ]]; then
    echo >&2 "Usage: $(basename "$0") [OPTIONS] <URL|PATH> [-- sv-args ...]"
    exit 1
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --)
            shift
            SV_ARGS=("$@")
            break
            ;;
        -v|--verbose)
            ((SV_VERBOSE++)) || true
            shift
            ;;
        -vv)
            ((SV_VERBOSE+=2)) || true
            shift
            ;;
        -vvv)
            ((SV_VERBOSE+=3)) || true
            shift
            ;;
        --profile|-P)
            SV_PROFILE="${2:?--profile requires a name}"
            shift 2
            ;;
        --profile=*)
            SV_PROFILE="${1#--profile=}"
            shift
            ;;
        -P?*)
            SV_PROFILE="${1#-P}"
            shift
            ;;
        -k|--repo-deploy-key)
            DEPLOY_KEY=true
            shift
            ;;
        -w|--allow-repo-write)
            DEPLOY_KEY=true
            DEPLOY_KEY_WRITE=true
            shift
            ;;
        -h|--help)
            echo "Usage: $(basename "$0") [-v|-vv|-vvv] [options] <URL|PATH> [-- sv-args ...]"
            echo ""
            echo "Clone a git repository into the sandvault shared workspace and"
            echo "launch an sv session there."
            echo ""
            echo "Options:"
            echo "  -P, --profile NAME      Use a named profile (separate sandbox)"
            echo "  -k, --repo-deploy-key   Create a deploy key for this repo and upload it"
            echo "                          to GitHub (read-only)"
            echo "  -w, --allow-repo-write  Allow the deploy key to push to this repo"
            echo "                          (implies --repo-deploy-key)"
            echo "  -v, --verbose           Enable verbose output"
            echo "  -vv / -vvv              More verbose / even more verbose"
            echo "  -h, --help              Show this help message"
            echo ""
            echo "Everything after -- is passed directly to sv."
            echo "If no sv command is given, defaults to 'shell'."
            exit 0
            ;;
        -*)
            abort "Unknown option: $1"
            ;;
        *)
            if [[ -z "$CLONE_REPOSITORY" ]]; then
                CLONE_REPOSITORY="$1"
                shift
            else
                abort "Unexpected argument: $1 (use -- to pass arguments to sv)"
            fi
            ;;
    esac
done

if [[ -z "$CLONE_REPOSITORY" ]]; then
    abort "Missing repository URL or path"
fi


###############################################################################
# Determine user and workspace paths
###############################################################################
# shellcheck source=helpers/sv-identity.sh
source "$WORKSPACE/helpers/sv-identity.sh"
readonly HOST_USER
# SV_CLONE_WORKSPACE_ROOT relocates the workspace so the test suite can clone
# into a throwaway directory instead of the real one — see scripts/tests.  It
# is not part of the supported interface; unset, this is the normal location.
readonly SHARED_WORKSPACE="${SV_CLONE_WORKSPACE_ROOT:-/Users/Shared/sv-$HOST_USER$SV_SUFFIX}"
readonly SV_PRIVATE_DIR="$SHARED_WORKSPACE/_sandvault"

if [[ ! -d "$SHARED_WORKSPACE" ]]; then
    abort "Shared workspace not found: $SHARED_WORKSPACE (run 'sv build' first)"
fi


###############################################################################
# Resolve repository name and source URL
###############################################################################
LOCAL_REPOSITORY=""
if [[ -d "$CLONE_REPOSITORY" ]]; then
    LOCAL_REPOSITORY="$(cd "$CLONE_REPOSITORY" && pwd -P)"
    # shellcheck disable=SC2310 # git_safe is a single git command
    REPOSITORY_SOURCE_URL="$(git_safe "$LOCAL_REPOSITORY" remote get-url origin 2>/dev/null)" \
        || abort "Local repository $LOCAL_REPOSITORY has no 'origin' remote"
    REPOSITORY_NAME="$(basename "$LOCAL_REPOSITORY")"
else
    REPOSITORY_SOURCE_URL="$CLONE_REPOSITORY"
    REPOSITORY_NAME="${REPOSITORY_SOURCE_URL%/}"
fi

# Extract bare repository name from URL
[[ "$REPOSITORY_NAME" == *"://"* ]] && REPOSITORY_NAME="${REPOSITORY_NAME##*/}"
if [[ "$REPOSITORY_NAME" == *:* ]]; then
    REPOSITORY_NAME="${REPOSITORY_NAME##*:}"
fi
REPOSITORY_NAME="${REPOSITORY_NAME##*/}"
REPOSITORY_NAME="${REPOSITORY_NAME%.git}"
if [[ -z "$REPOSITORY_NAME" ]]; then
    abort "Could not determine repository name from: $CLONE_REPOSITORY"
fi

readonly REPOSITORY_NAME
readonly REPOSITORY_SOURCE_URL
readonly CLONE_SOURCE="${LOCAL_REPOSITORY:-$REPOSITORY_SOURCE_URL}"
readonly REPO_DIR="$SHARED_WORKSPACE/repos/$REPOSITORY_NAME"

# Fixed regardless of whether -k/-w is given this run, so a later re-run
# (with or without those flags) can tell whether an earlier run already
# activated a deploy key for this repo — see the fetch step below.
readonly DEPLOY_KEY_PRIV="$SV_PRIVATE_DIR/.ssh/deploy_${REPOSITORY_NAME}"

debug "Repository: $REPOSITORY_NAME"
debug "Source URL: $REPOSITORY_SOURCE_URL"
debug "Clone from: $CLONE_SOURCE"
debug "Destination: $REPO_DIR"


# Pass --profile through to sv if set (deploy-key setup and the final launch)
SV_PROFILE_ARGS=()
if [[ -n "$SV_PROFILE" ]]; then
    SV_PROFILE_ARGS=("--profile" "$SV_PROFILE")
fi
readonly SANDVAULT_GROUP="sandvault-$HOST_USER$SV_SUFFIX"

###############################################################################
# Clone or fetch
###############################################################################
REPO_EXISTED=false
if [[ -d "$REPO_DIR/.git" ]]; then
    REPO_EXISTED=true
    # Defer the fetch until after the deploy key is (re)configured below; it
    # runs inside the sandbox (see the fetch step).
    debug "Repository already exists; will fetch after deploy-key setup"
else
    # Security: the host must not run git clone into the workspace. The
    # workspace is writable by the sandbox user, so a pre-created symlink
    # at repos/ or repos/<name> would redirect the clone elsewhere, and
    # the host's git would operate in an attacker-controlled directory.
    #
    # Instead: clone into a host-only temp dir, then have the sandbox user
    # move the clone into the workspace. This ensures the host's git never
    # touches sandbox-writable paths.
    debug "Cloning into host-only temp dir..."
    CLONE_TMP="$(mktemp -d /tmp/sv-clone.XXXXXX)"
    CLONE_TMP_REPO="$CLONE_TMP/$REPOSITORY_NAME"
    git clone --no-hardlinks "$CLONE_SOURCE" "$CLONE_TMP_REPO"

    # If cloned from a local path, set origin to the real remote URL.
    # This write is safe: the temp dir is host-owned.
    if [[ -n "$LOCAL_REPOSITORY" ]]; then
        git_safe "$CLONE_TMP_REPO" remote set-url origin "$REPOSITORY_SOURCE_URL"
    fi

    # Hand the clone to the sandbox user. Make it readable by the sandbox
    # group, then have the sandbox user move it into the workspace.
    chgrp -R "$SANDVAULT_GROUP" "$CLONE_TMP"
    chmod -R g+rX "$CLONE_TMP"
    {
        printf 'set -e\nmkdir -p %q\n' "$(dirname "$REPO_DIR")"
        printf 'if [ -e %q ]; then echo >&2 "destination already exists"; exit 1; fi\n' "$REPO_DIR"
        printf 'cp -a %q %q\n' "$CLONE_TMP_REPO" "$REPO_DIR"
    } | "$SV" "${SV_PROFILE_ARGS[@]+"${SV_PROFILE_ARGS[@]}"}" --no-build \
            shell "$SHARED_WORKSPACE" \
        || { rm -rf "$CLONE_TMP"; abort "Failed to install clone into workspace"; }
    rm -rf "$CLONE_TMP"
fi
info "Repository ready at $REPO_DIR"


###############################################################################
# Deploy key — opt-in for GitHub repositories
###############################################################################
# The sandvault user has no credentials. When -k/--repo-deploy-key (or
# -w/--allow-repo-write) is given, generate a per-repo ED25519 deploy key so
# the sandbox can pull (and, with -w, push). The key is uploaded read-only
# unless -w is given: sandvault runs agents in bypass-permissions mode, so
# write access is never granted implicitly. The origin remote is rewritten to
# SSH only once the key is confirmed usable, so a repo that cloned fine over
# HTTPS doesn't lose the ability to fetch if the upload fails. Keys are stored
# in $SV_PRIVATE_DIR/.ssh/ — outside the repo working tree, accessible to both
# users via group ACLs.

GITHUB_REPO_PATH=""
if [[ "$DEPLOY_KEY" == true ]]; then
    # Security: when the source is a local directory under the shared workspace,
    # the sandbox controls its git config (including remote URLs and insteadOf
    # rewriting). If the user gave a URL explicitly, the source URL is trusted;
    # if it was derived from a workspace-local repo's origin, the sandbox could
    # aim the deploy key at an arbitrary repository.
    if [[ -n "$LOCAL_REPOSITORY" ]]; then
        case "$LOCAL_REPOSITORY" in
            "$SHARED_WORKSPACE"/*|"$SHARED_WORKSPACE")
                abort "Deploy key (-k/-w) refused: the source repository is inside the" \
                    "sandbox workspace ($SHARED_WORKSPACE), so its remote URL is" \
                    "sandbox-controlled. Pass an explicit URL instead:" \
                    "  sv-clone -k <URL>"
                ;;
            *) ;;
        esac
        # Also check if the source is writable by any sandvault group
        _src_group="$(/usr/bin/stat -f '%Sg' "$LOCAL_REPOSITORY" 2>/dev/null || true)"
        case "$_src_group" in
            sandvault-*)
                abort "Deploy key (-k/-w) refused: the source repository is writable" \
                    "by the sandbox group ($_src_group). Pass an explicit URL instead:" \
                    "  sv-clone -k <URL>"
                ;;
            *) ;;
        esac
    fi

    # Extract owner/repo from the host-supplied source URL (the URL argument,
    # or the local repository's own origin). Never read it from the clone's
    # .git/config: the sandbox can rewrite that between runs to aim the deploy
    # key (and, with -w, write access) at a repository of its choosing.
    if [[ -n "$REPOSITORY_SOURCE_URL" ]]; then
        # Normalize: strip protocol/host prefixes and .git suffix
        GITHUB_REPO_PATH="$REPOSITORY_SOURCE_URL"
        GITHUB_REPO_PATH="${GITHUB_REPO_PATH#https://github.com/}"
        GITHUB_REPO_PATH="${GITHUB_REPO_PATH#http://github.com/}"
        GITHUB_REPO_PATH="${GITHUB_REPO_PATH#ssh://git@github.com/}"
        GITHUB_REPO_PATH="${GITHUB_REPO_PATH#git@github.com:}"
        GITHUB_REPO_PATH="${GITHUB_REPO_PATH#git@github.com/}"
        GITHUB_REPO_PATH="${GITHUB_REPO_PATH%.git}"

        # If it still looks like a full URL or local path, it's not GitHub
        if [[ "$GITHUB_REPO_PATH" == *"://"* || "$GITHUB_REPO_PATH" == /* ]]; then
            GITHUB_REPO_PATH=""
        fi

        # Validate the result looks like owner/repo
        if [[ -n "$GITHUB_REPO_PATH" && ! "$GITHUB_REPO_PATH" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
            GITHUB_REPO_PATH=""
        fi
    fi
fi

if [[ -n "$GITHUB_REPO_PATH" ]]; then
    DEPLOY_KEY_TITLE="sandvault-deploy-${REPOSITORY_NAME}@${HOSTNAME}"
    DEPLOY_SSH_URL="git@github.com:${GITHUB_REPO_PATH}.git"

    # $SV_PRIVATE_DIR/.ssh is writable by the sandbox user, so the host never opens
    # files there: a planted symlink (say, the .pub pointed at the host's
    # ~/.ssh/authorized_keys) would redirect the host's own write or read.
    # Instead the host generates the pair in a host-private temp dir and the
    # sandbox installs it with its own permissions; an existing key's public
    # half is read back through the sandbox as text and validated. Only the
    # host-owned copy in $DEPLOY_KEY_TMP is ever uploaded or printed.
    DEPLOY_KEY_TMP="$(mktemp -d)"
    trap 'rm -rf "$DEPLOY_KEY_TMP"' EXIT
    DEPLOY_KEY_PUB_HOST="$DEPLOY_KEY_TMP/deploy.pub"
    sandbox_run() {
        "$SV" "${SV_PROFILE_ARGS[@]+"${SV_PROFILE_ARGS[@]}"}" --no-build \
            shell "$SHARED_WORKSPACE" -- "$@"
    }

    # Only stat() here, which a symlink can't turn into a write.
    if [[ ! -f "$DEPLOY_KEY_PRIV" ]]; then
        ssh-keygen -t ed25519 \
            -f "$DEPLOY_KEY_TMP/deploy" \
            -N "" \
            -q \
            -C "$DEPLOY_KEY_TITLE"
        # The install script goes to the sandbox shell on stdin, not as
        # `sv shell -- <args>`: under sudo --login, $ in args is expanded by
        # the sandbox user's login shell (see sudo(8) -i). It also keeps the
        # private key out of argv. rm -f first so a planted symlink is
        # replaced, not followed.
        printf -v DEPLOY_KEY_PRIV_Q '%q' "$DEPLOY_KEY_PRIV"
        printf -v DEPLOY_KEY_DIR_Q '%q' "${DEPLOY_KEY_PRIV%/*}"
        {
            printf 'set -e\numask 077\nmkdir -p %s\nrm -f %s %s.pub\n' \
                "$DEPLOY_KEY_DIR_Q" "$DEPLOY_KEY_PRIV_Q" "$DEPLOY_KEY_PRIV_Q"
            printf "cat > %s <<'SV_DEPLOY_KEY_EOF'\n" "$DEPLOY_KEY_PRIV_Q"
            cat "$DEPLOY_KEY_TMP/deploy"
            printf "SV_DEPLOY_KEY_EOF\ncat > %s.pub <<'SV_DEPLOY_KEY_EOF'\n" "$DEPLOY_KEY_PRIV_Q"
            cat "$DEPLOY_KEY_PUB_HOST"
            printf 'SV_DEPLOY_KEY_EOF\nchmod 0644 %s.pub\n' "$DEPLOY_KEY_PRIV_Q"
        } | "$SV" "${SV_PROFILE_ARGS[@]+"${SV_PROFILE_ARGS[@]}"}" --no-build \
                shell "$SHARED_WORKSPACE" \
            || abort "Could not install the deploy key inside the sandbox"
        rm -f "$DEPLOY_KEY_TMP/deploy"   # $DEPLOY_KEY_PUB_HOST stays
        info "Generated deploy key for $REPOSITORY_NAME"
    else
        debug "Deploy key already exists for $REPOSITORY_NAME"
        # -P "" so a passphrase-protected key fails instead of prompting.
        # shellcheck disable=SC2310 # sandbox_run is a single sv command
        DEPLOY_KEY_PUB_LINE="$(sandbox_run ssh-keygen -y -P "" -f "$DEPLOY_KEY_PRIV" \
            </dev/null 2>/dev/null)" || DEPLOY_KEY_PUB_LINE=""
        DEPLOY_KEY_PUB_RE='^(ssh-ed25519 [A-Za-z0-9+/]+={0,2})( [^[:cntrl:]]*)?$'
        if [[ "$DEPLOY_KEY_PUB_LINE" == *$'\n'* || ! "$DEPLOY_KEY_PUB_LINE" =~ $DEPLOY_KEY_PUB_RE ]]; then
            abort "Existing deploy key $DEPLOY_KEY_PRIV is not a readable ed25519 key; remove it to regenerate"
        fi
        printf '%s\n' "${BASH_REMATCH[1]}" > "$DEPLOY_KEY_PUB_HOST"
        ssh-keygen -l -f "$DEPLOY_KEY_PUB_HOST" >/dev/null 2>&1 \
            || abort "Existing deploy key $DEPLOY_KEY_PRIV is not a valid public key; remove it to regenerate"
    fi

    # Only rewrite the origin to SSH and configure core.sshCommand once the
    # key is confirmed usable. Doing this unconditionally would strand a
    # public HTTPS clone if the upload below fails or gh is unavailable.
    # Run git config inside the sandbox so the host never writes to the
    # workspace clone's .git/config (which could be a symlink).
    activate_deploy_key() {
        sandbox_run git -C "$REPO_DIR" remote set-url origin "$DEPLOY_SSH_URL"
        debug "Set origin to $DEPLOY_SSH_URL"
        sandbox_run git -C "$REPO_DIR" config core.sshCommand \
            "ssh -i '$DEPLOY_KEY_PRIV' -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
    }

    DEPLOY_KEY_ACCESS=""
    if command -v gh &>/dev/null && gh auth status &>/dev/null; then
        # Look up any deploy key already registered under this title. GitHub
        # can't change a deploy key's permission level in place, so upgrading
        # read-only to write requires delete + re-add.
        EXISTING_KEY_LINE="$(gh repo deploy-key list -R "$GITHUB_REPO_PATH" \
            --json id,title,readOnly \
            --jq ".[] | select(.title == \"$DEPLOY_KEY_TITLE\") | [.id, .readOnly] | @tsv" \
            2>/dev/null)" || EXISTING_KEY_LINE=""

        if [[ -n "$EXISTING_KEY_LINE" ]]; then
            EXISTING_KEY_ID="${EXISTING_KEY_LINE%%$'\t'*}"
            EXISTING_KEY_READONLY="${EXISTING_KEY_LINE##*$'\t'}"
            if [[ "$DEPLOY_KEY_WRITE" == true && "$EXISTING_KEY_READONLY" == "true" ]]; then
                if gh repo deploy-key delete "$EXISTING_KEY_ID" -R "$GITHUB_REPO_PATH" 2>/dev/null \
                    && gh repo deploy-key add "$DEPLOY_KEY_PUB_HOST" \
                        --title "$DEPLOY_KEY_TITLE" --allow-write \
                        -R "$GITHUB_REPO_PATH" 2>/dev/null; then
                    activate_deploy_key
                    DEPLOY_KEY_ACCESS="write"
                    info "Deploy key for $GITHUB_REPO_PATH upgraded to write access"
                else
                    warn "Could not upgrade deploy key to write access (check repo permissions)"
                fi
            else
                # Already registered with sufficient access; just make sure
                # this clone is configured to use it (idempotent re-run).
                activate_deploy_key
                [[ "$EXISTING_KEY_READONLY" == "true" ]] && DEPLOY_KEY_ACCESS="read-only" || DEPLOY_KEY_ACCESS="write"
                debug "Deploy key already registered on $GITHUB_REPO_PATH ($DEPLOY_KEY_ACCESS)"
            fi
        else
            GH_ADD_ARGS=(--title "$DEPLOY_KEY_TITLE" -R "$GITHUB_REPO_PATH")
            [[ "$DEPLOY_KEY_WRITE" == true ]] && GH_ADD_ARGS+=(--allow-write)
            if gh repo deploy-key add "$DEPLOY_KEY_PUB_HOST" "${GH_ADD_ARGS[@]}" 2>/dev/null; then
                activate_deploy_key
                if [[ "$DEPLOY_KEY_WRITE" == true ]]; then
                    DEPLOY_KEY_ACCESS="write"
                    info "Deploy key added to $GITHUB_REPO_PATH (write access enabled)"
                else
                    DEPLOY_KEY_ACCESS="read-only"
                    info "Deploy key added to $GITHUB_REPO_PATH (read-only)"
                fi
            else
                warn "Could not add deploy key via gh CLI (check repo permissions)"
                echo ""
                info "Deploy key for $REPOSITORY_NAME — add manually:"
                echo "──────────────────────────────────────────────────────────"
                cat "$DEPLOY_KEY_PUB_HOST"
                echo "──────────────────────────────────────────────────────────"
                info "https://github.com/$GITHUB_REPO_PATH/settings/keys"
                echo ""
            fi
        fi
    else
        echo ""
        info "Deploy key for $REPOSITORY_NAME — add manually (or install gh CLI for auto-setup):"
        echo "──────────────────────────────────────────────────────────"
        cat "$DEPLOY_KEY_PUB_HOST"
        echo "──────────────────────────────────────────────────────────"
        info "https://github.com/$GITHUB_REPO_PATH/settings/keys"
        echo ""
    fi

    if [[ -n "$DEPLOY_KEY_ACCESS" ]]; then
        if [[ "$DEPLOY_KEY_ACCESS" == "write" ]]; then
            info "Sandbox access to $GITHUB_REPO_PATH: pull ✓  push ✓"
        else
            info "Sandbox access to $GITHUB_REPO_PATH: pull ✓  push ✗  (enable: sv-clone -w <url>)"
        fi
    fi

    # The final `exec sv` skips the EXIT trap, so clean up here.
    rm -rf "$DEPLOY_KEY_TMP"
    trap - EXIT
fi


###############################################################################
# Fetch an already-existing repository (deferred from the clone/fetch step)
###############################################################################
# The host never runs `git fetch` in the clone. Its .git/config is writable by
# the sandbox, and fetch runs commands named there (remote.<name>.uploadpack,
# core.alternateRefsCommand, credential.helper, core.gitProxy, ...) — too many
# for git_repo's -c overrides to cover. Instead the fetch runs inside the
# sandbox as the sandvault user, where poisoned config gains nothing. A local
# source isn't readable from the sandbox, so the host bundles HEAD from its
# own (trusted) repository into a fresh host-created directory the sandbox can
# read but not tamper with. Done after deploy-key setup so an SSH origin
# already has its core.sshCommand.
if [[ "$REPO_EXISTED" == true ]]; then
    # --no-build: the sandbox was already built (or verified) for the session
    # launch at the end of this script, so skip the rebuild check for the fetch.
    debug "Fetching existing repository inside the sandbox..."
    if [[ -n "$LOCAL_REPOSITORY" ]]; then
        BUNDLE_DIR="$(mktemp -d /tmp/sv-clone.XXXXXX)"
        BUNDLE_FILE="$BUNDLE_DIR/$REPOSITORY_NAME.bundle"
        git_safe "$LOCAL_REPOSITORY" bundle create -q "$BUNDLE_FILE" HEAD
        # The sandbox user's group is per-profile, like the user (see sv).
        chgrp -R "sandvault-$HOST_USER$SV_SUFFIX" "$BUNDLE_DIR"
        chmod 0750 "$BUNDLE_DIR"
        chmod 0640 "$BUNDLE_FILE"
        FETCH_STATUS=0
        "$SV" "${SV_PROFILE_ARGS[@]+"${SV_PROFILE_ARGS[@]}"}" --no-build shell "$REPO_DIR" -- \
            git fetch "$BUNDLE_FILE" || FETCH_STATUS=$?
        rm -rf "$BUNDLE_DIR"
        [[ "$FETCH_STATUS" -eq 0 ]] || abort "Fetch inside the sandbox failed (exit $FETCH_STATUS)"
    else
        "$SV" "${SV_PROFILE_ARGS[@]+"${SV_PROFILE_ARGS[@]}"}" --no-build shell "$REPO_DIR" -- \
            git fetch origin
    fi
fi


###############################################################################
# Add sandvault remote to local repository (if cloning from local)
###############################################################################
if [[ -n "$LOCAL_REPOSITORY" && -z "${SV_CLONE_WORKSPACE_ROOT:-}" ]]; then
    # shellcheck disable=SC2310 # git_safe is a single git command
    if git_safe "$LOCAL_REPOSITORY" remote get-url sandvault &>/dev/null; then
        git_safe "$LOCAL_REPOSITORY" remote set-url sandvault "$REPO_DIR"
    else
        git_safe "$LOCAL_REPOSITORY" remote add sandvault "$REPO_DIR"
    fi
    debug "Added 'sandvault' remote to $LOCAL_REPOSITORY"
fi


###############################################################################
# Launch sandvault session in the cloned repository
###############################################################################
# Default to "shell" if no sv args were given
if [[ ${#SV_ARGS[@]} -eq 0 ]]; then
    SV_ARGS=("shell")
fi

# Insert REPO_DIR after the first non-option argument (the sv command name)
# so it is always parsed as PATH, even when sv options precede the command.
LAUNCH_ARGS=()
REPO_DIR_INSERTED=false
for arg in "${SV_ARGS[@]}"; do
    LAUNCH_ARGS+=("$arg")
    if [[ "$REPO_DIR_INSERTED" == false && "$arg" != -* && "$arg" != "--" ]]; then
        LAUNCH_ARGS+=("$REPO_DIR")
        REPO_DIR_INSERTED=true
    fi
done
if [[ "$REPO_DIR_INSERTED" == false ]]; then
    LAUNCH_ARGS+=("$REPO_DIR")
fi

info "Starting sandvault in $REPO_DIR..."
exec "$SV" "${SV_PROFILE_ARGS[@]+"${SV_PROFILE_ARGS[@]}"}" "${LAUNCH_ARGS[@]}"
