#!/usr/bin/env python3
"""
Pick the newest available iOS runtime and the newest iPhone device type it
supports. A runtime that supports no iPhone (e.g. a partially installed one)
is skipped in favor of the next newest.

Reads `xcrun simctl list -j devicetypes runtimes` JSON on stdin and prints
"<device_type_identifier>\t<runtime_identifier>" on stdout. Exits non-zero if
no usable pair is available.
"""

import json
import re
import sys


def rt_key(r):
    m = re.search(r"(\d+)\.(\d+)", r.get("version", "") or "")
    return (int(m.group(1)), int(m.group(2))) if m else (0, 0)


def dt_key(d):
    name = d.get("name", "")
    m = re.search(r"iPhone\s+(\d+)", name)
    return (int(m.group(1)) if m else 0, name)


def main():
    # `xcrun simctl` writes nothing to stdout when Xcode isn't installed
    # (only the Command Line Tools). Exit non-zero rather than traceback.
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        sys.exit(1)

    runtimes = [
        r for r in data.get("runtimes", [])
        if r.get("isAvailable") and "iOS" in (r.get("name") or "")
    ]
    runtimes.sort(key=rt_key, reverse=True)

    devs = [
        d for d in data.get("devicetypes", [])
        if d.get("productFamily") == "iPhone" and "iPhone" in (d.get("name") or "")
    ]
    devs.sort(key=dt_key, reverse=True)

    for r in runtimes:
        # Older simctl versions omit supportedDeviceTypes; assume all supported.
        supported = r.get("supportedDeviceTypes")
        ids = None if supported is None else {d.get("identifier") for d in supported}
        for d in devs:
            if ids is None or d["identifier"] in ids:
                print(f"{d['identifier']}\t{r['identifier']}")
                return
    sys.exit(1)


if __name__ == "__main__":
    main()
